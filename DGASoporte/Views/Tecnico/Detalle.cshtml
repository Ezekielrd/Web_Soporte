@using DGASoporte.Models.Enumeradores
@model TareaFormVM

@{
    ViewData["Title"] = "Detalle de Tarea";
    Layout = null;

    var estado = Model.Estado ?? EstadoT.EnEspera;

    var estadoKey = estado switch
    {
        EstadoT.EnEspera => "pendiente",
        EstadoT.EnProceso => "proceso",
        EstadoT.Resuelta => "completado",
        EstadoT.Asignado => "asignado",
        _ => "pendiente"
    };

    var prioridadKey = Model.Prioridad.ToString().ToLower();

    var totalHoras = (int)Model.TiempoInvertido.TotalHours;
    var minutos = Model.TiempoInvertido.Minutes;
    var tiempoInvertidoTexto = $"{totalHoras:D2} h {minutos:D2} m";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN"
          crossorigin="anonymous">
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link href="~/css/detalleTarea.css" rel="stylesheet"asp-append-version="true" />
</head>
<body>
    <div class="main-container">
        <div class="header-section">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h1 class="mb-1">
                        <i class="bi bi-list-check me-2"></i>
                        Mis Tareas
                    </h1>
                    <p class="text-muted mb-0">
                        Gestiona y organiza tus Tareas
                    </p>
                </div>

                <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end header-actions">
                    <span class="badge bg-primary d-inline-flex align-items-center header-date-badge"
                          style="font-size: 1rem; padding: 0.5rem 1rem;">
                        <i class="bi bi-calendar-event me-2"></i>
                        @DateTime.Now.ToString("dd/MM/yyyy")
                    </span>

                    <div class="notification-wrapper position-relative">
                        <button id="btnNotificaciones"
                                type="button"
                                class="btn btn-link nav-link position-relative p-0">
                            <i class="bi bi-bell fs-5"></i>
                            <span id="notifBadge"
                                  class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">
                                0
                            </span>
                        </button>

                        <!-- Panel flotante -->
                        <div id="notifPanel"
                             class="card shadow border-0 position-absolute end-0 mt-2 d-none"
                             style="width: 340px; z-index: 1050;">
                            <div class="card-header d-flex justify-content-between align-items-center py-2">
                                <div>
                                    <i class="bi bi-bell me-1"></i>
                                    <span>Notificaciones</span>
                                </div>
                                <button type="button"
                                        class="btn-close btn-close-sm"
                                        aria-label="Cerrar"
                                        id="btnCerrarNotif"></button>
                            </div>
                            <div class="list-group list-group-flush small" id="notifList">
                                <div class="list-group-item text-muted text-center py-3" id="notifPlaceholder">
                                    Cargando...
                                </div>
                            </div>
                            <div class="card-footer text-center">
                                <form id="formMarcarLeidas"
                                      method="post"
                                      asp-controller="Notificaciones"
                                      asp-action="MarcarTodasComoLeidas">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-link btn-sm text-decoration-none">
                                        Marcar todas como leídas
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <a href="@Url.Action("Logout", "Cuenta")"
                       id="btnLogout"
                       class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-2 logout-btn">
                        <span class="logout-icon-wrapper d-inline-flex align-items-center justify-content-center">
                            <i class="bi bi-box-arrow-right"></i>
                        </span>
                        <span class="logout-text">Cerrar sesión</span>
                    </a>
                </div>
            </div>
        </div>
        <!-- Header tipo tarjeta (como en Index) -->
        <div class="header-section mb-3">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm mb-2 btn-back"
                            onclick="history.back()">
                        <i class="bi bi-arrow-left-short"></i> Volver
                    </button>

                    <h2 class="mb-1">
                        <i class="bi bi-ticket-detailed me-2"></i>
                        @Model.Titulo
                    </h2>
                    <p class="text-muted mb-0">
                        Tarea #@Model.Id — creada el @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                    </p>
                </div>


                <div class="text-end">
                    <div class="mb-2">
                        <span class="badge badge-estado-@estadoKey" style="border-radius:999px;padding:.25rem .7rem;">
                            <i class="bi bi-circle-fill me-1"></i> @Model.Estado
                        </span>
                        <span class="badge badge-priority-@prioridadKey ms-1">
                            <i class="bi bi-flag-fill me-1"></i> @Model.Prioridad
                        </span>
                    </div>

                    <div class="small text-muted">
                        @{
                            // segundos acumulados hasta ahora (solo lo que está guardado en BD)
                            var totalSegundosBase = (int)Model.TiempoInvertido.TotalSeconds;
                            var contadorActivoJs = Model.ContadorActivo ? "true" : "false";
                        }
                        <div class="mb-3">
                            <div class="small text-muted mb-1">Tiempo invertido</div>
                            <div class="fw-semibold">
                                <span id="lblTiempoInvertido"
                                      data-tiempo-base="@totalSegundosBase"
                                      data-contador-activo="@contadorActivoJs">
                                    00 h 00 m 00 s
                                </span>
                            </div>
                        </div>

                        @if (Model.FechaLimite.HasValue)
                        {
                            <div>
                                <i class="bi bi-alarm me-1"></i>
                                Fecha límite:
                                <strong>@Model.FechaLimite.Value.ToString("dd/MM/yyyy HH:mm")</strong>
                            </div>
                        }
                        else
                        {
                            <div>
                                <i class="bi bi-alarm me-1"></i>
                                <span class="text-muted">Sin fecha límite</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="toast-container">
            @if (TempData["Success"] != null)
            {
                <div class="toast-msg toast-success">
                    <span class="toast-icon">✔</span>
                    <span>@TempData["Success"]</span>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="toast-msg toast-error">
                    <span class="toast-icon">⚠</span>
                    <span>@TempData["Error"]</span>
                </div>
            }

            @* Puedes usar TempData["Alert"] para mensajes informativos/amarillos *@
            @if (TempData["Alert"] != null)
            {
                <div class="toast-msg toast-alert">
                    <span class="toast-icon">ℹ</span>
                    <span>@TempData["Alert"]</span>
                </div>
            }
        </div>


        <!-- Contenido principal -->
        <div class="detalle-main-card">
            <div class="row g-4">
                <!-- Izquierda -->
                <div class="col-lg-7">
                    <h5 class="mb-2">
                        <i class="bi bi-card-text me-2"></i> Descripción / Detalles
                    </h5>
                    <div class="detalle-descripcion mb-4">
                        @if (!string.IsNullOrWhiteSpace(Model.Descripcion))
                        {
                            @Html.Raw(Model.Descripcion.Replace("\n", "<br />"))
                        }
                        else
                        {
                            <span class="text-muted">Sin descripción detallada.</span>
                        }
                    </div>

                    <h6 class="mb-2">
                        <i class="bi bi-person-gear me-2"></i> Asignación
                    </h6>

                    <div class="row g-3 mb-3">
                        <!-- Columna 1: datos técnicos -->
                        <div class="col-md-6">
                            <h6 class="text-muted small mb-2">
                                <i class="bi bi-cpu me-1"></i> Datos técnicos
                            </h6>

                            <div class="detalle-meta-grid">
                                <div class="detalle-meta-item">
                                    <i class="bi bi-person-badge"></i>
                                    <div>
                                        <div class="fw-semibold">Técnico asignado</div>
                                        <div>@(Model.TecnicoNombre ?? "Sin técnico")</div>
                                    </div>
                                </div>

                                <div class="detalle-meta-item">
                                    <i class="bi bi-tools"></i>
                                    <div>
                                        <div class="fw-semibold">Tipo de servicio</div>
                                        <div>@(Model.TipoServicioNombre ?? "No especificado")</div>
                                    </div>
                                </div>

                                <div class="detalle-meta-item">
                                    <i class="bi bi-tag"></i>
                                    <div>
                                        <div class="fw-semibold">Categoría</div>
                                        <div>@(Model.CategoriaNombre ?? "No especificada")</div>
                                    </div>
                                </div>                              
                            </div>
                        </div>

                        <!-- Columna 2: datos del solicitante -->
                        <div class="col-md-6">
                            <h6 class="text-muted small mb-2">
                                <i class="bi bi-person-lines-fill me-1"></i> Datos del solicitante
                            </h6>

                            <div class="detalle-meta-grid">
                                <div class="detalle-meta-item">
                                    <i class="bi bi-person"></i>
                                    <div>
                                        <div class="fw-semibold">Solicitante</div>
                                        <div>@Model.UsuarioNombre</div>
                                    </div>
                                </div>

                                <div class="detalle-meta-item">
                                    <i class="bi bi-diagram-3"></i>
                                    <div>
                                        <div class="fw-semibold">Unidad</div>
                                        <div>@(Model.UnidadNombre ?? "No especificada")</div>
                                    </div>
                                </div>

                                <div class="detalle-meta-item">
                                    <i class="bi bi-diagram-2"></i>
                                    <div>
                                        <div class="fw-semibold">División</div>
                                        <div>@(Model.DivisionNombre ?? "No especificada")</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Derecha -->
                <div class="col-lg-5">
                    <h5 class="mb-3">
                        <i class="bi bi-info-circle me-2"></i> Resumen rápido
                    </h5>

                    <div class="mb-3">
                        <div class="small text-muted mb-1">Estado</div>
                        <span class="badge badge-estado-@estadoKey" style="border-radius:999px;padding:.25rem .7rem;">
                            <i class="bi bi-circle-fill me-1"></i> @Model.EstadoNombre
                        </span>
                    </div>

                    <div class="mb-3">
                        <div class="small text-muted mb-1">Prioridad</div>
                        <span class="badge badge-priority-@prioridadKey">
                            <i class="bi bi-flag-fill me-1"></i> @Model.PrioridadNombre
                        </span>
                    </div>

                    <div class="mb-3">
                        <div class="small text-muted mb-1">Tiempo invertido</div>
                        <div class="fw-semibold">@tiempoInvertidoTexto</div>
                    </div>

                    <div class="mb-3">
                        <div class="small text-muted mb-1">Creada</div>
                        <div>@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>

                    @if (Model.FechaLimite.HasValue)
                    {
                        <div class="mb-3">
                            <div class="small text-muted mb-1">Fecha límite</div>
                            <div>@Model.FechaLimite.Value.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    }
                    <div class="mt-4">
                        @if (Model.Estado == EstadoT.Asignado && Model.TecnicoId != null)
                        {
                            <form asp-action="IniciarTarea"
                                  asp-route-id="@Model.Id"
                                  method="post"
                                  class="d-inline">
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-primary btn-sm btn-back">
                                    <i class="bi bi-play-circle me-1"></i> Iniciar tarea
                                </button>
                            </form>
                        }

                        @* 👉 Estado: ASIGNADO — botón de diagnóstico *@
                        @if (Model.Estado == EstadoT.EnProceso && Model.TecnicoId != null && !Model.TieneDiagnostico)
                        {
                            <div class="d-flex gap-2 flex-wrap">
                                <button type="button"
                                        class="btn btn-primary btn-sm btn-back"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalDiagnostico">
                                    <i class="bi bi-stethoscope me-1"></i> Realizar diagnóstico
                                </button>
                            </div>
                        }

                        @* 👉 Estado: EN PROCESO (contador activo) — Pausar + Finalizar/En espera *@
                        @if (Model.Estado == EstadoT.EnProceso && Model.ContadorActivo)
                        {
                            <div class="d-flex gap-2 flex-wrap mt-2">
                                <button type="button"
                                        class="btn btn-outline-warning btn-sm"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalPausa">
                                    <i class="bi bi-pause-circle me-1"></i> Pausar tiempo
                                </button>

                                <form asp-action="Finalizar" asp-route-id="@Model.Id" method="post" class="d-flex gap-2 flex-wrap">
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            name="resultado"
                                            value="Resuelta"
                                            class="btn btn-danger btn-sm">
                                        <i class="bi bi-flag-fill me-1"></i> Finalizar como resuelta
                                    </button>

                                    <button type="submit"
                                            name="resultado"
                                            value="EnEspera"
                                            class="btn btn-outline-warning btn-sm">
                                        <i class="bi bi-pause-circle me-1"></i> Dejar en espera
                                    </button>
                                </form>
                            </div>
                        }

                        @* 👉 Estado: PAUSADO — Reanudar + Finalizar/En espera *@
                        @if (Model.Estado == EstadoT.Pausado)
                        {
                            <div class="d-flex gap-2 flex-wrap mt-2">
                                <form asp-controller="Tecnico"
                                      asp-action="ReanudarTarea"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="TareaId" value="@Model.Id" />
                                    <button type="submit"
                                            class="btn btn-outline-success btn-sm">
                                        <i class="bi bi-play-circle me-1"></i> Reanudar tiempo
                                    </button>
                                </form>

                                <form asp-action="Finalizar" asp-route-id="@Model.Id" method="post" class="d-flex gap-2 flex-wrap">
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            name="resultado"
                                            value="Resuelta"
                                            class="btn btn-danger btn-sm">
                                        <i class="bi bi-flag-fill me-1"></i> Finalizar como resuelta
                                    </button>

                                    <button type="submit"
                                            name="resultado"
                                            value="EnEspera"
                                            class="btn btn-outline-warning btn-sm">
                                        <i class="bi bi-pause-circle me-1"></i> Dejar en espera
                                    </button>
                                </form>
                            </div>
                        }

                        @if (Model.TieneReporte)
                        {
                            @* Solo técnicos editan el reporte *@
                            @if (User.IsInRole("Tecnico"))
                            {
                                <a asp-controller="Tecnico"
                                   asp-action="ReporteSolucion"
                                   asp-route-id="@Model.Id"
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-pencil-square me-1"></i> Editar reporte
                                </a>
                            }

                            @* Ver reporte (admin + técnico) *@
                            <a asp-controller="Reportes"
                               asp-action="ReporteIncidencia"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-eye me-1"></i> Ver reporte de solución
                            </a>

                            @* Descargar PDF (admin + técnico) *@
                            <a asp-controller="Reportes"
                               asp-action="ReporteIncidenciaPdf"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-dark btn-sm">
                                <i class="bi bi-filetype-pdf me-1"></i> Descargar PDF
                            </a>
                        }

                        @* 👉 Bloque de comentarios técnicos (En proceso) *@
                        @if (Model.Estado == EstadoT.EnProceso)
                        {
                            <div class="historial-card mt-4">
                                <h5 class="mb-2">
                                    <i class="bi bi-chat-dots me-2"></i> Agregar comentario técnico
                                </h5>

                                <form asp-controller="Tecnico"
                                      asp-action="AgregarComentario"
                                      method="post">
                                    @Html.AntiForgeryToken()

                                    @Html.HiddenFor(m => m.ComentarioForm.TareaId)

                                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                                    <div class="mb-3">
                                        <label asp-for="ComentarioForm.Texto"
                                               class="form-label fw-semibold"></label>
                                        <textarea asp-for="ComentarioForm.Texto"
                                                  class="form-control"
                                                  rows="3"
                                                  placeholder="Escribe aquí observaciones, avances, pruebas realizadas, etc."></textarea>
                                        <span asp-validation-for="ComentarioForm.Texto"
                                              class="text-danger small"></span>
                                    </div>

                                    <div class="d-flex justify-content-end">
                                        <button type="submit"
                                                class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-send me-1"></i> Guardar comentario
                                        </button>
                                    </div>
                                </form>
                            </div>
                        }

                    </div>


                </div>
            </div>
        </div>
        @if (Model.DiagnosticoTexto != null)
        {
            <div class="historial-card mt-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="mb-0">
                        <i class="bi bi-stethoscope me-2"></i> Diagnóstico registrado
                    </h5>
                    <div class="text-end small text-muted">
                        @if (!string.IsNullOrWhiteSpace(Model.CodigoDiagnostico))
                        {
                            <div>
                                <span class="badge bg-light text-dark">
                                    Código: @Model.CodigoDiagnostico
                                </span>
                            </div>
                        }
                        @if (Model.DiagnosticoFecha.HasValue)
                        {
                            <div>
                                Registrado el @Model.DiagnosticoFecha.Value.ToString("dd/MM/yyyy HH:mm")
                                @if (!string.IsNullOrWhiteSpace(Model.DiagnosticoTecnicoNombre))
                                {
                                    <span> por @Model.DiagnosticoTecnicoNombre</span>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="detalle-descripcion mb-3">
                    <strong>Diagnóstico:</strong><br />
                    @Model.DiagnosticoTexto
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.DiagnosticoAcciones))
                {
                    <div class="detalle-descripcion mb-3">
                        <strong>Acciones propuestas:</strong><br />
                        @Model.DiagnosticoAcciones
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.DiagnosticoComentarios))
                {
                    <div class="detalle-descripcion">
                        <strong>Comentarios adicionales:</strong><br />
                        @Model.DiagnosticoComentarios
                    </div>
                }
            </div>
        }

        <!-- Historial -->
        <div class="historial-card mt-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="mb-0">
                    <i class="bi bi-clock-history me-2"></i> Historial de comentarios
                </h5>
                <span class="badge bg-light text-muted">
                    @Model.Historial?.Count() registro(s)
                </span>
            </div>

            @if (Model.Historial != null && Model.Historial.Any())
            {
                <div class="timeline mt-2">
                    @foreach (var c in Model.Historial)
                    {
                        <div class="timeline-item">
                            <div class="timeline-header">
                                <div>
                                    <i class="bi bi-calendar-event me-1"></i>
                                    @c.FechaHora.ToString("dd/MM/yyyy HH:mm")
                                </div>
                                <div class="text-end">
                                    <span class="badge bg-light text-dark">
                                        Comentario
                                    </span>
                                </div>
                            </div>
                            <div class="timeline-body">
                                @if (!string.IsNullOrWhiteSpace(c.Texto))
                                {
                                    <div>@c.Texto</div>
                                }
                                else
                                {
                                    <div class="text-muted fst-italic">Sin comentario.</div>
                                }

                                @if (c.Usuario != null)
                                {
                                    <div class="small text-muted mt-1">
                                        <i class="bi bi-person-circle me-1"></i>
                                        @c.Usuario.NombreCompleto
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center text-muted py-3">
                    <i class="bi bi-inbox mb-2 d-block" style="font-size: 2rem;"></i>
                    No hay comentarios registrados para esta tarea.
                </div>
            }
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Modal Diagnóstico -->
    <div class="modal fade" id="modalDiagnostico" tabindex="-1" aria-labelledby="modalDiagnosticoLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalDiagnosticoLabel">
                        <i class="bi bi-stethoscope me-2"></i> Diagnóstico de la incidencia
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <form method="post" asp-controller="Tecnico" asp-action="RegistrarDiagnostico">
                    @Html.AntiForgeryToken()

                    @Html.HiddenFor(m => m.DiagnosticoForm.TareaId)

                    <div class="modal-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                        <div class="mb-3">
                            <label asp-for="DiagnosticoForm.Codigo" class="form-label fw-semibold"></label>
                            <input asp-for="DiagnosticoForm.Codigo"
                                   class="form-control"
                                   placeholder="Ej. DIAG-2025-001" />
                            <span asp-validation-for="DiagnosticoForm.Codigo" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DiagnosticoForm.Texto" class="form-label fw-semibold"></label>
                            <textarea asp-for="DiagnosticoForm.Texto"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Describe el problema encontrado, pruebas realizadas, observaciones técnicas, etc."></textarea>
                            <span asp-validation-for="DiagnosticoForm.Texto" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DiagnosticoForm.AccionesPropuestas" class="form-label fw-semibold"></label>
                            <textarea asp-for="DiagnosticoForm.AccionesPropuestas"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Indica los pasos a seguir para resolver la incidencia."></textarea>
                            <span asp-validation-for="DiagnosticoForm.AccionesPropuestas" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DiagnosticoForm.ComentariosAdicionales" class="form-label fw-semibold"></label>
                            <textarea asp-for="DiagnosticoForm.ComentariosAdicionales"
                                      class="form-control"
                                      rows="2"
                                      placeholder="Notas adicionales para el usuario o para otro técnico."></textarea>
                            <span asp-validation-for="DiagnosticoForm.ComentariosAdicionales" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>
                        <button type="submit"
                                class="btn btn-primary btn-sm">
                            <i class="bi bi-save me-1"></i> Guardar diagnóstico
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!-- Modal Pausa -->
    <div class="modal fade" id="modalPausa" tabindex="-1" aria-labelledby="modalPausaLabel" aria-hidden="true">
        <div class="modal-dialog modal-md modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalPausaLabel">
                        <i class="bi bi-pause-circle me-2"></i> Pausar tiempo de la tarea
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <form method="post" asp-controller="Tecnico" asp-action="PausarTarea">
                    @Html.AntiForgeryToken()

                    @Html.HiddenFor(m => m.PausaForm.TareaId)

                    <div class="modal-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                        <div class="mb-3">
                            <label asp-for="PausaForm.Motivo" class="form-label fw-semibold"></label>
                            <textarea asp-for="PausaForm.Motivo"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Describa claramente por qué se está pausando la atención de esta tarea."></textarea>
                            <span asp-validation-for="PausaForm.Motivo" class="text-danger small"></span>
                        </div>

                        <p class="text-muted small mb-0">
                            Al pausar, el tiempo transcurrido hasta este momento se registrará como <strong>tiempo invertido</strong>
                            y el motivo quedará guardado en el historial de la tarea.
                        </p>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>
                        <button type="submit"
                                class="btn btn-warning btn-sm">
                            <i class="bi bi-pause-fill me-1"></i> Confirmar pausa
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <link rel="stylesheet" href="~/lib/sweetalert2/dist/sweetalert2.css" />
    <script src="~/lib/sweetalert2/dist/sweetalert2.js"></script>
    <script src="~/lib/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/cliente/campana.js"></script>
    <script src="~/js/notificaciones.js"></script>
    <script>
        (function () {
            const span = document.getElementById('lblTiempoInvertido');
            if (!span) return;

            let baseSeconds = parseInt(span.dataset.tiempoBase || "0", 10);
            if (isNaN(baseSeconds)) baseSeconds = 0;

            const contadorActivo = span.dataset.contadorActivo === "true";

            function formatTiempo(seconds) {
                if (seconds < 0) seconds = 0;
                const h = Math.floor(seconds / 3600);
                const m = Math.floor((seconds % 3600) / 60);
                const s = seconds % 60;

                const hh = h.toString().padStart(2, '0');
                const mm = m.toString().padStart(2, '0');
                const ss = s.toString().padStart(2, '0');

                return `${hh} h ${mm} m ${ss} s`;
            }

            let currentSeconds = baseSeconds;

            // Mostrar valor inicial
            span.textContent = formatTiempo(currentSeconds);

            // Si el contador está activo, incrementamos cada segundo
            if (contadorActivo) {
                setInterval(() => {
                    currentSeconds++;
                    span.textContent = formatTiempo(currentSeconds);
                }, 1000);
            }
            if (contadorActivo) {
                setInterval(() => {
                    currentSeconds++;
                    span.textContent = formatTiempo(currentSeconds);
                }, 1000);
            }
        })();
    </script>

</body>
</html>
