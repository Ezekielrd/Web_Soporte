@model IEnumerable<DGASoporte.Models.Solicitud>

@{
    ViewData["Title"] = "Lista de Solicitudes";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - DGASoporte</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="~/css/solicitudesC.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
</head>
<body>
    <div class="container-fluid px-4 no-select">
        <h1 class="mb-4 mt-3">Lista de Solicitudes</h1>

        <!-- Tarjetas de Estadísticas -->
        <div class="row g-3 mb-4 tarjetas">
            <!-- Total -->
            <div class="col-12 col-sm-6 col-md-2">
                <div class="card text-white bg-primary h-100 shadow-sm">
                    <div class="card-body py-3 px-3">
                        <div class="d-flex justify-content-between align-items-center h-100">
                            <div class="flex-grow-1">
                                <h4 class="card-title mb-1 fw-bold">@ViewBag.TotalSolicitudes</h4>
                                <p class="card-text mb-0 small">Total</p>
                            </div>
                            <div class="ms-2">
                                <i class="fas fa-list" style="font-size: 1.8rem; opacity: 0.9;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Nuevas -->
            <div class="col-12 col-sm-6 col-md-2">
                <div class="card text-white bg-info h-100 shadow-sm">
                    <div class="card-body py-3 px-3">
                        <div class="d-flex justify-content-between align-items-center h-100">
                            <div class="flex-grow-1">
                                <h4 class="card-title mb-1 fw-bold">@ViewBag.EnviadaSolicitud</h4>
                                <p class="card-text mb-0 small">Enviadas</p>
                            </div>
                            <div class="ms-2">
                                <i class="fas fa-plus-circle" style="font-size: 1.8rem; opacity: 0.9;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- En Espera -->
            <div class="col-12 col-sm-6 col-md-2">
                <div class="card text-white bg-warning h-100 shadow-sm">
                    <div class="card-body py-3 px-3">
                        <div class="d-flex justify-content-between align-items-center h-100">
                            <div class="flex-grow-1">
                                <h4 class="card-title mb-1 fw-bold">@ViewBag.EnEsperaSolicitudes</h4>
                                <p class="card-text mb-0 small">En Espera</p>
                            </div>
                            <div class="ms-2">
                                <i class="fas fa-clock" style="font-size: 1.8rem; opacity: 0.9;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Aprobadas -->
            <div class="col-12 col-sm-6 col-md-2">
                <div class="card text-white bg-success h-100 shadow-sm">
                    <div class="card-body py-3 px-3">
                        <div class="d-flex justify-content-between align-items-center h-100">
                            <div class="flex-grow-1">
                                <h4 class="card-title mb-1 fw-bold">@ViewBag.AprobadaSolicitudes</h4>
                                <p class="card-text mb-0 small">Aprobadas</p>
                            </div>
                            <div class="ms-2">
                                <i class="fas fa-check-circle" style="font-size: 1.8rem; opacity: 0.9;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Rechazadas -->
            <div class="col-12 col-sm-6 col-md-2">
                <div class="card text-white bg-danger h-100 shadow-sm">
                    <div class="card-body py-3 px-3">
                        <div class="d-flex justify-content-between align-items-center h-100">
                            <div class="flex-grow-1">
                                <h4 class="card-title mb-1 fw-bold">@ViewBag.RechazadaSolicitudes</h4>
                                <p class="card-text mb-0 small">Rechazadas</p>
                            </div>
                            <div class="ms-2">
                                <i class="fas fa-times-circle" style="font-size: 1.8rem; opacity: 0.9;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filtros de Búsqueda -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0">
                        <i class="bi bi-funnel me-2 text-primary"></i> Filtros de búsqueda
                    </h5>
                    <small class="text-muted">Refina la lista de solicitudes</small>
                </div>
            </div>

            <div class="card-body p-3">
                <form id="filtrosSolicitudes" class="row g-3 align-items-end mb-0">
                    <div class="col-md-4">
                        <label for="estado" class="form-label small text-uppercase fw-semibold text-muted">
                            <i class="bi bi-flag me-1 text-primary"></i> Estado
                        </label>
                        <select class="form-select form-select-sm" id="estado" name="estado"
                                asp-items="@(ViewBag.Estados as IEnumerable<SelectListItem>)">
                            <option value="">Todos los estados</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label for="tipoId" class="form-label small text-uppercase fw-semibold text-muted">
                            <i class="bi bi-tags me-1 text-primary"></i> Tipo de incidencia
                        </label>
                        <select class="form-select form-select-sm" id="tipoId" name="tipoId"
                                asp-items="@(ViewBag.TiposIncidencia as IEnumerable<SelectListItem>)">
                            <option value="">Todos los tipos</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <div class="form-check form-switch mt-4">
                            <input class="form-check-input" type="checkbox" name="incluirArchivadas" value="true"
                                   id="chkArch" />
                            <label class="form-check-label small" for="chkArch">
                                Incluir archivadas
                            </label>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Contenedor de la tabla de solicitudes -->
        <div class="card shadow-sm border-0 tabla-solicitudes-wrapper">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0">
                        <i class="bi bi-ticket-perforated me-1 text-primary"></i> Solicitudes
                    </h5>
                    <small class="text-muted">
                        @Model.Count() registro(s)
                    </small>
                </div>

                <a asp-action="Create" class="btn btn-success btn-sm shadow-sm">
                    <i class="bi bi-file-earmark-text me-1"></i> Nueva solicitud
                </a>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm align-middle mb-0" id="tablaSolicitud">
                        <thead>
                            <tr>
                                <th class="col-titulo">Título</th>
                                <th class="col-descripcion">Descripción</th>
                                <th class="col-unidad">Unidad</th>
                                <th class="col-tipo">Tipo</th>
                                <th class="col-estado">Estado</th>
                                <th class="col-fecha">Creación</th>
                                <th class="col-acciones text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Any())
                            {
                                @foreach (var solicitud in Model)
                                {
                                    <tr>
                                        <td class="col-titulo">
                                            <strong>@solicitud.Titulo</strong>
                                        </td>

                                        <td class="col-descripcion">
                                            <span class="texto-2-lineas" title="@solicitud.Descripcion">
                                                @(solicitud.Descripcion.Length > 140
                                                                   ? solicitud.Descripcion.Substring(0, 140) + "..."
                                                                   : solicitud.Descripcion)
                                    </span>
                                </td>
                                        <td class="col-unidad">
                                            <span class="text-muted small">
                                                @solicitud.Unidad?.Nombre
                                            </span>
                                        </td>

                                        <td class="col-tipo">
                                            <span class="badge rounded-pill bg-light text-dark border small">
                                                @solicitud.TipoIncidencia?.Nombre
                                            </span>
                                        </td>

                                        <td class="col-estado">
                                             @if (solicitud.Estado == DGASoporte.Models.Enumeradores.EstadoS.Enviada)
                                                {
                                                    <span class="badge rounded-pill bg-primary small">Enviada</span>
                                                }
                                                else if (solicitud.Estado == DGASoporte.Models.Enumeradores.EstadoS.EnEspera)
                                                {
                                                    <span class="badge rounded-pill bg-warning text-dark small">En espera</span>
                                                }
                                                else if (solicitud.Estado == DGASoporte.Models.Enumeradores.EstadoS.Aprobada)
                                                {
                                                    <span class="badge rounded-pill bg-success small">Aprobada</span>
                                                }
                                                else if (solicitud.Estado == DGASoporte.Models.Enumeradores.EstadoS.Rechazada)
                                                {
                                                    <span class="badge rounded-pill bg-danger small">Rechazada</span>
                                                }
                                                else
                                                {
                                                    <span class="badge rounded-pill bg-secondary small">@solicitud.Estado</span>
                                                }
                                        </td>

                                        <td class="col-fecha">
                                            <span class="small text-muted">
                                                @solicitud.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                                            </span>
                                        </td>

                                        <td class="col-acciones text-end">
                                            <div class="d-flex flex-wrap justify-content-end gap-1">
                                                <button type="button"
                                                        class="btn btn-outline-primary btn-accion btn-sm js-detalle-solicitud"
                                                        title="Ver detalle"
                                                        data-titulo="@solicitud.Titulo"
                                                        data-descripcion="@solicitud.Descripcion"
                                                        data-unidad="@solicitud.Unidad?.Nombre"
                                                        data-tipo="@solicitud.TipoIncidencia?.Nombre"
                                                        data-estado="@solicitud.Estado.ToString()">
                                                    <i class="bi bi-eye"></i>
                                                </button>

                                                @if (!solicitud.Archivada)
                                                {
                                                    <form asp-action="Archivar" asp-route-id="@solicitud.Id" method="post" class="d-inline">
                                                        <button class="btn btn-warning btn-accion btn-sm" type="submit" title="Archivar">
                                                            <i class="bi bi-archive"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">
                                        <i class="fas fa-inbox mb-2" style="font-size: 2rem;"></i>
                                        <div>No se encontraron solicitudes con los filtros aplicados.</div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div> 
        </div>

        <div class="modal fade" id="modalConfirmacion" tabindex="-1" aria-labelledby="modalConfirmacionLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalConfirmacionLabel">Detalle de la Solicitud</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-12">
                                <h6 class="text-primary mb-3" id="modalSubtitulo">
                                    Información de la solicitud seleccionada:
                                </h6>

                                <div class="card">
                                    <div class="card-body">
                                        <div class="row mb-3">
                                            <div class="col-sm-3">
                                                <strong>Título:</strong>
                                            </div>
                                            <div class="col-sm-9">
                                                <span id="modalTitulo" class="text-dark"></span>
                                            </div>
                                        </div>

                                        <div class="row mb-3">
                                            <div class="col-sm-3">
                                                <strong>Descripción:</strong>
                                            </div>
                                            <div class="col-sm-9">
                                                <span id="modalDescripcion" class="text-dark"></span>
                                            </div>
                                        </div>

                                        <div class="row mb-3">
                                            <div class="col-sm-3">
                                                <strong>Unidad:</strong>
                                            </div>
                                            <div class="col-sm-9">
                                                <span id="modalUnidad" class="text-dark"></span>
                                            </div>
                                        </div>

                                        <div class="row mb-3">
                                            <div class="col-sm-3">
                                                <strong>TipoIncidencia:</strong>
                                            </div>
                                            <div class="col-sm-9">
                                                <span id="modalTipo" class="text-dark"></span>
                                            </div>
                                        </div>

                                        <div class="row mb-3">
                                            <div class="col-sm-3">
                                                <strong>Estado</strong>
                                            </div>
                                            <div class="col-sm-9">
                                                <span id="modalEstado" class="text-dark"></span>
                                            </div>
                                        </div>
                                    </div> <!-- card-body -->
                                </div> <!-- card -->
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <!-- Como es solo detalle, puedes dejar solo el botón cerrar -->
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cerrar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/cliente/modal.js"></script>
    <!--datatable-->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/cliente/filtrosCl.js"></script>
</body>
</html>

