@model DGASoporte.Models.SolicitudVM
@inject IJsonHelper Json

@{
    ViewData["Title"] = "Crear Solicitud de Incidencia";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Portal de Reporte de Incidencias - Dirección General de Aduanas</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN"
          crossorigin="anonymous">
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"
          integrity="sha512-..."
          crossorigin="anonymous"
          referrerpolicy="no-referrer" />
    <link href="~/css/solicitud-incidencia.css" rel="stylesheet" />
    <link href="~/css/librerias/sweetalert2.min.css" rel="stylesheet" />

</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-8 mx-auto">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h4 class="mb-0 no-select">
                            <i class="fas fa-plus-circle"></i>
                            Nueva Solicitud de Incidencia
                        </h4>
                        <span class="badge no-select">Sistema de Tareas</span>
                    </div>
                    <div class="card-body">
                        <form asp-action="Create" method="post" id="formSolicitud" novalidate>
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            @Html.AntiForgeryToken()
                            <div class="row">
                              
                                <div class="col-md-4">
                                    <div class="form-group mb-3">
                                        <label asp-for="TipoIncidenciaId" class="form-label no-select">
                                            <i class="fas fa-tag text-warning"></i>
                                            @Html.DisplayNameFor(model => model.TipoIncidenciaId)
                                        </label>
                                        <select asp-for="TipoIncidenciaId" class="form-control" asp-items="Model.TipoIncidencias">
                                            <option value="">-- Seleccione tipo --</option>
                                        </select>
                                        <span asp-validation-for="TipoIncidenciaId" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-8">
                                    <div class="form-group mb-3">
                                        <label asp-for="Titulo" class="form-label no-select">
                                            <i class="fas fa-heading text-primary"></i>
                                            @Html.DisplayNameFor(model => model.Titulo)
                                        </label>
                                        <input asp-for="Titulo" class="form-control" placeholder="Ej: Problema con impresora en oficina" maxlength="100" />
                                        <span asp-validation-for="Titulo" class="text-danger"></span>
                                        <div class="form-text">
                                            <span id="titulo-count" class="no-select">0</span>/100 caracteres
                                        </div>
                                    </div>
                                 </div>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Descripcion" class="form-label no-select">
                                    <i class="fas fa-align-left text-info"></i>
                                    @Html.DisplayNameFor(model => model.Descripcion)
                                </label>
                                <textarea asp-for="Descripcion" class="form-control" rows="6" placeholder="Describa detalladamente el problema."></textarea>
                                <span asp-validation-for="Descripcion" class="text-danger"></span>
                                <div class="form-text">
                                    <span id="descripcion-count" class="no-select">0</span> caracteres
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="DivisionId" class="form-label"></label>
                                    <select asp-for="DivisionId"
                                            asp-items="Model.Divisiones"
                                            class="form-control" id="DivisionId">
                                        <option value="">-- Seleccione división --</option>
                                    </select>
                                    <span asp-validation-for="DivisionId" class="text-danger"></span>
                                </div>
                                <div class="col-md-6" id="grupoUnidad">
                                    <label asp-for="UnidadId" class="form-label"></label>
                                    <select asp-for="UnidadId" class="form-control" id="UnidadId">
                                        <option value="">-- Seleccione unidad --</option>

                                        @foreach (var u in Model.Unidades)
                                        {
                                            var divisionId = u.DivisionId.HasValue ? u.DivisionId.Value.ToString() : "";
                                            <option value="@u.Id" data-division="@divisionId">@u.Nombre</option>

                                        }
                                    </select>
                                    <span asp-validation-for="UnidadId" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-4">
                                <div>
                                    <button type="submit" class="btn btn-primary btn-lg" id="btnEnviar">
                                        <i class="fas fa-paper-plane"></i>
                                        <span class="btn-text">Enviar</span>
                                        <span class="spinner-border spinner-border-sm ms-2 d-none" id="spinnerEnviar"></span>
                                    </button>
                                </div>
                                <div>
                                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                        <i class="bi bi-x-circle"></i> Cancelar
                                    </a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
        <script src="~/js/tareas.js"></script><!--divisones/unidades-->
        <script>
            (function() {
            const map = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MapTipoDesc));
            const sel = document.getElementById('TipoIncidenciaId');
              if (!sel) return;

              Array.from(sel.options).forEach(opt => {
                const desc = map[opt.value];
                if (desc) {
                  opt.title = desc;           // tooltip nativo
                  opt.dataset.desc = desc;  
                }
              });

            })();
        </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('formSolicitud');
            const btn = document.getElementById('btnEnviar');
            const spinner = document.getElementById('spinnerEnviar');

            if (!form || !btn) return;

            form.addEventListener('submit', function (e) {
                // 1) Si tienes jQuery Validate (MVC unobtrusive)
                if (typeof $ !== 'undefined' && $.validator && $(form).data('validator')) {
                    if (!$(form).valid()) {
                        // ❌ Formulario inválido → NO tocamos el botón
                        return;
                    }
                }
                // 2) Si no hubiera jQuery Validate, usamos HTML5
                else if (!form.checkValidity()) {
                    return;
                }

                // ✅ Si llegó aquí, el formulario es VÁLIDO → animamos el botón
                btn.disabled = true;
                btn.classList.add('disabled');

                if (spinner) {
                    spinner.classList.remove('d-none');
                }

                const textSpan = btn.querySelector('.btn-text');
                if (textSpan) {
                    textSpan.textContent = 'Enviando...';
                }
            });
        });
    </script>


</body>
</html>
