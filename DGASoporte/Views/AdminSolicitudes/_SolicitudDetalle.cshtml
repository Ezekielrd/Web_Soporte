@using DGASoporte.Models.Enumeradores

@model DGASoporte.Models.Solicitud
@{
    Layout = null;
    ViewData["Title"] = "Detalle de Solicitud #" + Model.Id;
}

<div class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-ticket-perforated-fill"></i> Solicitud #@Model.Id
            </h5>
            <a href="#" class="btn btn-sm btn-light js-close-modal"> <i class="bi bi-arrow-left"></i> Regresar</a>
        </div>

        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="fw-bold">Título</label>
                    <p class="form-control-plaintext border rounded bg-light px-2">@Model.Titulo</p>
                </div>
                <div class="col-md-3">
                    <label class="fw-bold">Fecha de creación</label>
                    <p class="form-control-plaintext border rounded bg-light px-2">@Model.FechaCreacion.ToString("g")</p>
                </div>
                <div class="col-md-3">
                    <label class="fw-bold">Estado</label>
                    @{
                        var badge = Model.Estado switch
                        {
                            EstadoS.EnEspera => "warning",
                            EstadoS.Enviada => "info",
                            EstadoS.Aprobada  => "success",
                            EstadoS.Rechazada => "danger",
                            _ => "secondary"
                        };
                    }
                    <p>
                        <span class="badge bg-@badge fs-6">@Model.Estado</span>
                    </p>
                </div>
            </div>

            <div class="mb-3">
                <label class="fw-bold">Descripción</label>
                <div class="border rounded bg-light p-3">
                    @Html.Raw(Model.Descripcion.Replace("\n", "<br/>"))
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="fw-bold">Usuario reportante</label>
                    <p class="form-control-plaintext border rounded bg-light px-2">@Model.Usuario?.NombreCompleto</p>
                </div>
                <div class="col-md-4">
                    <label class="fw-bold">Unidad</label>
                    <p class="form-control-plaintext border rounded bg-light px-2">@Model.Unidad?.Nombre</p>
                </div>
                <div class="col-md-4">
                    <label class="fw-bold">Tipo de incidencia</label>
                    <p class="form-control-plaintext border rounded bg-light px-2">@Model.TipoIncidencia?.Nombre</p>
                </div>
            </div>

            @if (Model.Estado == EstadoS.Rechazada && !string.IsNullOrEmpty(Model.MotivoRechazo))
            {
                <div class="alert alert-danger">
                    <h6 class="fw-bold">Motivo de rechazo</h6>
                    @Model.MotivoRechazo
                </div>
            }

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Volver al listado
                </a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="bi bi-pencil"></i> Editar
                </a>
            </div>
        </div>
    </div>
</div>
}
