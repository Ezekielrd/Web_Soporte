@using DGASoporte.Models
@using DGASoporte.Models.Enumeradores
@model TareaAsignarVM

@{
    Layout = null;
}

<h2 class="h5 mb-3">Asignar Tarea</h2>

<div class="form-section grid-2">
    <div>
        <dt>Tarea</dt>
        <dd>@Model.Tarea.Titulo</dd>
    </div>
    <div>
        <dt>Prioridad</dt>
        <dd>@Model.Tarea.Prioridad.ToString()</dd>
    </div>

    <form asp-action="Asignar" method="post" class="mt-3" data-ajax-tarea="true">
        @Html.AntiForgeryToken()
        <input type="hidden" name="tareaId" value="@Model.Tarea.Id" />

        <div class="row g-3">
            <div class="mb-3">
                <label for="nivelSelect" class="form-label">
                    <i class="bi bi-layer-backward"></i> Nivel
                </label>
                <select id="nivelSelect" class="form-select filter-input">
                    <option value="">Todos los niveles</option>
                    @foreach (var n in Model.Niveles)
                    {
                        <option value="@n.Id">@n.Nombre</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label for="tecnicoSelect" class="form-label">
                    <i class="bi bi-person"></i> Técnico
                </label>
                <select id="tecnicoSelect" class="form-select filter-input" name="tecnicoId">
                    <option value="">Todos los técnicos</option>
                    @foreach (var t in Model.Tecnicos)
                    {
                        var cant = t.TareasAsignadas.Count(ta => ta.Estado == EstadoT.EnProceso);
                        <option value="@t.Id"
                                data-cant="@cant"
                                data-nivel="@t.Nivel?.Id">
                            @t.Usuario.NombreCompleto (@cant sin cerrar)
                        </option>
                    }
                </select>
                <span id="tecnicoBadge" class="badge mt-1"></span>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-3">
            <button type="button" class="btn btn-secondary js-close-modal" data-bs-dismiss="modal">
                Cancelar
            </button>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check2-circle"></i> Asignar
            </button>
        </div>
    </form>
</div>

<form asp-action="AsignarAuto"
      asp-controller="Tareas"
      method="post"
      class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" name="tareaId" value="@Model.Tarea.Id" />
    <button type="submit" class="btn btn-sm btn-outline-success">
        Auto
    </button>
</form>

<script>
    (function () {
        const select = document.getElementById('tecnicoSelect');
        const badge  = document.getElementById('tecnicoBadge');
        if (!select || !badge) return;

        function actualizarBadge() {
            const opt = select.selectedOptions[0];
            if (!opt || !opt.value) {
                badge.textContent = '';
                badge.className = 'badge mt-1';
                return;
            }

            const cant = parseInt(opt.dataset.cant || '0', 10);
            badge.textContent = cant + ' sin cerrar';

            if (cant === 0) {
                badge.className = 'badge bg-success mt-1';
            } else if (cant <= 5) {
                badge.className = 'badge bg-warning text-dark mt-1';
            } else {
                badge.className = 'badge bg-danger mt-1';
            }
        }

        select.addEventListener('change', actualizarBadge);
        actualizarBadge();
    })();
</script>

<script>
    (function () {
        const nivelSel   = document.getElementById('nivelSelect');
        const tecnicoSel = document.getElementById('tecnicoSelect');
        if (!nivelSel || !tecnicoSel) return;

        nivelSel.addEventListener('change', () => {
            const nivelId = nivelSel.value;

            Array.from(tecnicoSel.options).forEach(opt => {
                if (!opt.value) {
                    opt.hidden = false;
                    return;
                }

                const optNivel = opt.dataset.nivel;
                if (!nivelId) {
                    opt.hidden = false;
                } else {
                    opt.hidden = optNivel !== nivelId;
                }
            });

            const sel = tecnicoSel.selectedOptions[0];
            if (sel && sel.hidden) {
                tecnicoSel.value = '';
            }
        });
    })();
</script>
