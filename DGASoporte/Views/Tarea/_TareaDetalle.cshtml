@model TareaFormVM
@{
    Layout = null;
}
<link href="~/css/cardTarea.css" rel="stylesheet" />
<div class="wizard-card">
    <div class="card-body p-4 p-md-4">
        <div class="wizard-header d-flex align-items-center">
            <div class="wizard-icon-circle">
                <i class="bi bi-kanban fs-5"></i>
            </div>
            <div>
                <h3 class="mb-0">
                    <i class="bi bi-card-text me-2"></i>
                    Detelle de la Tarea</h3>
                <div class="wizard-subtitle">
                    Inspecionar los detalles de las tareas.
                </div>
            </div>
            <div class="ms-auto d-none d-md-block">
                <span class="badge-soft">
                    <i class="bi bi-shield-check me-1"></i> Soporte Técnico
                </span>
            </div>
        </div>
            <dl class="row mb-0">
                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Titulo)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.Titulo)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Descripcion)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.Descripcion)</dd>


                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Prioridad)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.PrioridadNombre)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.CategoriaId)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.CategoriaNombre)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.TipoServicioId)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.TipoServicioNombre)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.UnidadId)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.UnidadNombre)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.TecnicoId)</dt>
                <dd class="col-sm-8">
                    @(Model.TecnicoId == null || Model.TecnicoId == 0
                                        ? "Sin técnico asignado"
                                        : Model.TecnicoNombre)
                </dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Estado)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.EstadoNombre)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.FechaAsignacion)</dt>
                <dd class="col-sm-8">
                    @(Model.FechaAsignacion?.ToString("dd/MM/yyyy") ?? "—")
                </dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.FechaLimite)</dt>
                <dd class="col-sm-8">
                    @(Model.FechaLimite?.ToString("dd/MM/yyyy") ?? "—")
                </dd>
            </dl>

            <div class="mt-3 text-end g-5">
                <a asp-action="EditarModal" asp-controller="Tarea" asp-route-id="@Model.Id" class="btn btn-success js-modal-link">Editar</a>
                <button type="button"
                    class="btn btn-gradient-primary js-close-modal"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>
    </div>
</div>