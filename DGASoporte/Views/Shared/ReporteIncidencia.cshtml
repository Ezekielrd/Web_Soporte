@model ReporteIncidenciaVM

@{
    ViewData["Title"] = "Reporte de solución de incidencia";
    Layout = null; 
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Tarea #@Model.Id</title>

    <!-- Bootstrap CSS (para que Rotativa también lo pueda usar) -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/ReporteIncidencia.css" asp-append-version="true" />
</head>
<body>
    <div class="report-wrapper">

        <!-- 🔷 CABECERA DEL REPORTE -->
        <div class="report-header d-flex flex-column flex-md-row justify-content-between align-items-start">
            <div>
                <!-- Aquí podrías poner el logo institucional de tu DGA -->
                <img src="/img/dga.jpeg" alt="DGA" class="mb-2" style="height:40px;" />

                <h2 class="fw-bold mb-1">
                    <i class="bi bi-file-earmark-check-fill me-2"></i>
                    Reporte de solución de incidencia
                </h2>

                <div class="opacity-75">
                    Tarea #@Model.Id – @Model.Titulo
                </div>

                <div class="small opacity-75 mt-1">
                    Creada: @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                    @if (Model.FechaCierre.HasValue)
                    {
                        <span> | Resuelta: @Model.FechaCierre.Value.ToString("dd/MM/yyyy HH:mm")</span>
                    }
                </div>
            </div>

            <div class="text-end mt-3 mt-md-0">
                <span class="badge bg-light text-dark badge-pill me-1">Estado: @Model.Estado</span>
                <span class="badge bg-success badge-pill">Prioridad: @Model.Prioridad</span>

                <div class="mt-3">
                    <div class="small opacity-75">Tiempo invertido:</div>
                    <div class="fw-bold fs-5">@Model.TiempoInvertidoTexto</div>
                </div>

                <div class="mt-3 d-print-none">
                    <a onclick="history.back()"
                       class="btn btn-sm btn-outline-light me-1">
                        <i class="bi bi-arrow-left"></i> Volver
                    </a>

                    <a asp-action="ReporteIncidenciaPdf" asp-route-id="@Model.Id"
                       class="btn btn-sm btn-dark">
                        <i class="bi bi-filetype-pdf me-1"></i> Descargar PDF
                    </a>
                </div>
            </div>
        </div>

        <!-- 🔶 CONTENIDO DEL REPORTE -->
        <div class="report-page">

            <!-- 1. Información general -->
            <div class="subsection">
                <div class="section-title">Información general</div>

                <div class="info-box">
                    <div class="row g-3">

                        <div class="col-md-4">
                            <div class="report-label">Solicitante</div>
                            <div class="report-value">@Model.Solicitante</div>
                        </div>

                        <div class="col-md-4">
                            <div class="report-label">Unidad</div>
                            <div class="report-value">@Model.Unidad</div>
                        </div>

                        <div class="col-md-4">
                            <div class="report-label">División</div>
                            <div class="report-value">@(Model.Division ?? "No especificada")</div>
                        </div>

                        <div class="col-md-4">
                            <div class="report-label">Categoría</div>
                            <div class="report-value">@Model.Categoria</div>
                        </div>

                        <div class="col-md-4">
                            <div class="report-label">Tipo de servicio</div>
                            <div class="report-value">@(Model.TipoServicio ?? "No especificado")</div>
                        </div>

                        <div class="col-md-4">
                            <div class="report-label">Técnico asignado</div>
                            <div class="report-value">@Model.TecnicoAsignado</div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="divider"></div>

            <!-- 2. Descripción del problema -->
            <div class="subsection">
                <div class="section-title">Descripción del problema</div>

                <div class="info-box">
                    <div class="report-value">
                        @Model.DescripcionUsuario
                    </div>
                </div>
            </div>

            <div class="divider"></div>

            <!-- 3. Diagnóstico y análisis técnico -->
            <div class="subsection">
                <div class="section-title">Diagnóstico y análisis técnico</div>

                @if (!string.IsNullOrWhiteSpace(Model.CausaRaiz))
                {
                    <div class="mb-3">
                        <div class="report-label">Causa raíz:</div>
                        <div class="report-value">@Model.CausaRaiz</div>
                    </div>
                }
                else
                {
                    <div class="text-muted fst-italic">No se registró causa raíz.</div>
                }
            </div>

            <div class="divider"></div>

            <!-- 4. Acciones realizadas -->
            <div class="subsection">
                <div class="section-title">Acciones realizadas por el técnico</div>

                @if (!string.IsNullOrWhiteSpace(Model.PasosEjecutados))
                {
                    <div class="mb-3">
                        <div class="report-label">Pasos ejecutados:</div>
                        <div class="report-value">@Model.PasosEjecutados</div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.AjustesRealizados))
                {
                    <div class="mb-3">
                        <div class="report-label">Reemplazos / Configuraciones / Ajustes:</div>
                        <div class="report-value">@Model.AjustesRealizados</div>
                    </div>
                }

                @if (string.IsNullOrWhiteSpace(Model.PasosEjecutados)
                                && string.IsNullOrWhiteSpace(Model.AjustesRealizados))
                {
                    <div class="text-muted fst-italic">
                        No se registraron acciones detalladas del técnico.
                    </div>
                }
            </div>

            <div class="divider"></div>

            <!-- 5. Resultado final -->
            <div class="subsection">
                <div class="section-title">Resultado final</div>

                <div class="info-box">
                    <div class="report-value">
                        @(string.IsNullOrWhiteSpace(Model.ResultadoFinal)
                                                ? "No se registró un resultado final."
                                                : Model.ResultadoFinal)
                    </div>
                </div>
            </div>

            <div class="divider"></div>

            <!-- 6. Recomendaciones -->
            <div class="subsection">
                <div class="section-title">Recomendaciones</div>

                <div class="info-box">
                    <div class="report-value">
                        @(string.IsNullOrWhiteSpace(Model.Recomendaciones)
                                                ? "No se registraron recomendaciones."
                                                : Model.Recomendaciones)
                    </div>
                </div>
            </div>

            <div class="report-footer">
                Reporte generado el @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>
    </div>

    <!-- Bootstrap Icons (para los íconos bi-*) -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
</body>
</html>
