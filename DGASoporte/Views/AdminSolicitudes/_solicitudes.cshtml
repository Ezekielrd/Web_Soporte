@using DGASoporte.Models.Enumeradores
@model IEnumerable<Solicitud>

@{
    Layout = null;
    ViewData["Title"] = "Gestión de Solicitudes de Soporte";
}
<link rel="stylesheet" href="~/css/solicitudes-cards.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

<div class="toast-container">
    @if (TempData["Success"] != null)
    {
        <div class="toast-msg toast-success">
            <span class="toast-icon">✔</span>
            <span>@TempData["Success"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="toast-msg toast-error">
            <span class="toast-icon">⚠</span>
            <span>@TempData["Error"]</span>
        </div>
    }
    @if (TempData["Alert"] != null)
    {
        <div class="toast-msg toast-alert">
            <span class="toast-icon">ℹ</span>
            <span>@TempData["Alert"]</span>
        </div>
    }
</div>
<!-- Filtros -->
<div class="row g-3 sol-filtros-wrapper mb-3">

    <!-- ESTADO -->
    <div class="col-12 col-md-4">
        <label class="form-label">Estado</label>
        <select id="filtroEstado" class="form-select">
            <option value="">Todos</option>
            <option value="enviada">Enviada (Pendiente)</option>
            <option value="aprobada">Aprobada</option>
            <option value="rechazada">Rechazada</option>
            <option value="cerrada">Cerrada</option>
        </select>
    </div>

    <!-- SEMANA -->
    <div class="col-12 col-md-4">
        <label class="form-label">Semana</label>
        <select id="filtroSemana" class="form-select"></select>
        <small class="text-muted">Últimos 30 días</small>
    </div>

    <!-- DÍA -->
    <div class="col-12 col-md-4">
        <label class="form-label">Día</label>
        <select id="filtroDia" class="form-select"></select>
        <small class="text-muted">Solo días dentro de la semana seleccionada</small>
    </div>
</div>

<!-- CARDS -->
<div class="row g-3 sol-cards-wrapper mb-3">

    <div class="col-12 col-md-3">
        <div class="sol-card sol-cerradas">
            <div class="sol-card-icon"><i class="bi bi-check-circle-fill"></i></div>
            <div class="sol-card-label">Cerradas</div>
            <div class="sol-card-value js-sol-num">0</div>
            <div class="sol-card-footer">Solicitudes</div>
        </div>
    </div>

    <div class="col-12 col-md-3">
        <div class="sol-card sol-pendientes">
            <div class="sol-card-icon"><i class="bi bi-hourglass-split"></i></div>
            <div class="sol-card-label">Pendientes</div>
            <div class="sol-card-value js-sol-num">0</div>
            <div class="sol-card-footer">Estado: Enviada</div>
        </div>
    </div>

    <div class="col-12 col-md-3">
        <div class="sol-card sol-aprobadas">
            <div class="sol-card-icon"><i class="bi bi-check-circle"></i></div>
            <div class="sol-card-label">Aprobadas</div>
            <div class="sol-card-value js-sol-num">0</div>
            <div class="sol-card-footer">Convertidas en tarea</div>
        </div>
    </div>

    <div class="col-12 col-md-3">
        <div class="sol-card sol-rechazadas">
            <div class="sol-card-icon"><i class="bi bi-x-circle"></i></div>
            <div class="sol-card-label">Rechazadas</div>
            <div class="sol-card-value js-sol-num">0</div>
            <div class="sol-card-footer">No aprobadas</div>
        </div>
    </div>

</div>
<div class="container-fluid px-4 mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0 no-select"><i class="bi bi-ticket-perforated"></i> Bandeja de Solicitudes</h4>
            <span id="countBadge" class="badge bg-light text-primary fs-6 sol-total">
                <div class="sol-card-value js-sol-num">0</div>
            </span>
        </div>

        <div class="card-body no-select">
            <table id="tablaSolicitudes" class="table table-striped table-hover w-100">
                <thead class="table-light">
                    <tr>
                        <th>Título</th>
                        <th>Usuario</th>
                        <th>Unidad</th>
                        <th>Division</th>
                        <th>Tipo</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        var estadoTexto = s.Estado?.ToString().ToLower() ?? "";

                        <tr data-id="@s.Id" data-fecha-creacion="@s.FechaCreacion.ToString("yyyy-MM-dd")"
                            data-estado="@estadoTexto">
                            <td class="text-truncate" style="max-width:180px;" title="@s.Titulo">@s.Titulo</td>
                            <td>@s.Usuario.NombreCompleto</td>
                            <td>@s.Unidad.Nombre</td>
                            <td>@(s.Division?.Nombre ?? "-")</td>
                            <td>@s.TipoIncidencia.Nombre</td>
                            <td>@s.FechaCreacion.ToString("g")</td>
                            <td>
                                @{
                                    var badge = s.Estado switch
                                    {
                                        EstadoS.Enviada => "info",
                                        EstadoS.Aprobada => "success",
                                        EstadoS.Rechazada => "danger",
                                        EstadoS.Cerrada => "primary",
                                        _ => "secondary"
                                    };
                                }
                                <span class="badge bg-@badge estado-badge">@s.Estado</span>
                            </td>
                            <td class="text-end text-nowrap">
                                <div class="d-flex justify-content-end gap-2">
                                    <a class="btn btn-sm btn-outline-primary js-modal-link" data-solicitud-id="@s.Id"
                                       asp-action="Details"
                                       asp-route-id="@s.Id">
                                        <i class="bi bi-eye"></i> Ver
                                    </a>
                                    @if (s.Estado==EstadoS.Enviada)
                                    {
                                        <a asp-controller="Tarea" asp-action="Create"
                                           asp-route-solicitudId="@s.Id"
                                           class="btn btn-outline-success btn-sm js-modal-link"
                                           data-modal="true">
                                            <i class="bi bi-check-circle"></i> Aprobar
                                        </a>                                     
                                        <a href="@Url.Action("Rechazar", "AdminSolicitudes", new { id = s.Id })"
                                           class="btn btn-sm btn-outline-danger btn-sm js-modal-link"
                                           data-title="Rechazar solicitud">
                                            <i class="bi bi-x-circle-fill"></i> Rechazar
                                        </a>
                                    }
                                   
                                </div>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
