@model UsuarioVM
@using System

<link href="~/css/cardUsaurio.css" rel="stylesheet" />
<div class="usuario-page">
    <div class="usuario-card">
        <div class="usuario-card__bar"></div>

        <div class="usuario-card__header">
            <h3 class="title">Detalle de usuario</h3>
            <div class="actions">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-gd">Editar</a>
                <a asp-action="Index" class="btn btn-cl">Volver</a>
            </div>
        </div>

        <div class="usuario-card__body">
            <dl class="form-section grid-2">
                <div>
                    <dt>Nombre</dt>
                    <dd>@Model.User</dd>
                </div>
                <div>
                    <dt>Correo</dt>
                    <dd>@Model.Email</dd>
                </div>
                <div>
                    <dt>NombreCompleto</dt>
                    <dd>@Model.NombreCompleto</dd>
                </div>
                <div>
                    <dt>Rol</dt>
                    <dd>@(Model.Rol.Nombre)</dd>
                </div>
                <div>
                    <dt>Fecha de Creación</dt>
                    <dd>@Model.FechaCracion.ToString("yyyy-MM-dd")</dd>
                </div>
                <div>
                    <dt>Estado</dt>
                    <dd>
                        @if (Model.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {

                            <span class="badge bg-secondary">Desactivo</span>
                        }
                    </dd>
                </div>
            </dl>
        </div>
    </div>
</div>
