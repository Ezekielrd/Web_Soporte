@model TareaFormVM
@{
    Layout = null;
}
<link href="~/css/cardTarea.css" rel="stylesheet" />

<div class="wizard-card-tarea no-select">
    <div class="card-body-tarea p-4 p-md-4">
        <!-- Cabecera -->
        <div class="wizard-header-tarea d-flex align-items-center mb-3">
            <div class="wizard-icon-circle me-3">
                <i class="bi bi-kanban fs-5"></i>
            </div>
            <div>
                <h3 class="mb-0">
                    <i class="bi bi-card-text me-2"></i>
                    Detalle de la Tarea
                </h3>
                <div class="wizard-subtitle">
                    Inspeccionar los detalles de las tareas.
                </div>
            </div>
            <div class="ms-auto d-none d-md-block">
                <span class="badge-soft">
                    <i class="bi bi-shield-check me-1"></i> Soporte Técnico
                </span>
            </div>
        </div>

        <hr class="detalle-separator" />

        <!-- Datos -->
        <dl class="row detalle-dl mb-0">
            <dt class="col-sm-4">Título de Tarea</dt>
            <dd class="col-sm-8 fw-semibold">@Html.DisplayFor(m => m.Titulo)</dd>

            <dt class="col-sm-4">Descripción de la Tarea</dt>
            <dd class="col-sm-8">
                <div class="detalle-descripcion-scroll">
                    @Model.Descripcion
                </div>
            </dd>


            <dt class="col-sm-4">Prioridad</dt>
            <dd class="col-sm-8">
                <span class="badge-prioridad" data-prioridad="@Model.PrioridadNombre">
                    @Model.PrioridadNombre
                </span>
            </dd>

            <dt class="col-sm-4">Categoría</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.CategoriaNombre)</dd>

            <dt class="col-sm-4">Tipo Servicio</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.TipoServicioNombre)</dd>

            <dt class="col-sm-4">Área</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.UnidadNombre)</dd>

            <dt class="col-sm-4">Técnico</dt>
            <dd class="col-sm-8">
                @(Model.TecnicoId == null || Model.TecnicoId == 0
                                ? "Sin técnico asignado"
                                : Model.TecnicoNombre)
            </dd>

            <dt class="col-sm-4">Estado</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.EstadoNombre)</dd>

            <dt class="col-sm-4">Área</dt>
            <dd class="col-sm-8">@Html.DisplayFor(m => m.UsuarioNombre)</dd>


            <dt class="col-sm-4">Fecha Límite</dt>
            <dd class="col-sm-8">
                @(Model.FechaLimite?.ToString("dd/MM/yyyy") ?? "—")
            </dd>
        </dl>

        <div class="mt-4 text-end">
            <a asp-action="Edit"
               asp-controller="Tarea"
               asp-route-id="@Model.Id"
               class="btn btn-success js-modal-link">
                Editar
            </a>

            <button type="button"
                    class="btn btn-gradient-primary js-close-modal"
                    data-bs-dismiss="modal">
                Cerrar
            </button>
        </div>
    </div>
</div>
