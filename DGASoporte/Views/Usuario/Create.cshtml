@model DGASoporte.Models.UsuarioVM
@using Microsoft.AspNetCore.Mvc.Rendering
<link href="~/css/cardUsaurio.css" rel="stylesheet" />
<div class="usuario-page">
    <div class="usuario-card">
        <div class="usuario-card__bar"></div>

        <div class="usuario-card__header">
            <div>
                <h3 class="usuario-title" id="no-select">Agregar usuario</h3>
                <div class="usuario--sub" id="no-select">Crea una cuenta con rol y contraseña seguras</div>
            </div>
            <a asp-action="Index" class="link-back">Volver</a>
        </div>

        <div class="usuario-card__body">
            <form asp-action="Create" method="post" id="formCambiarContrasena" novalidate>
                @Html.AntiForgeryToken()

                <div class="form-section grid-2">
                    <div>
                        <label asp-for="User" class="form-label no-select"></label>
                        <input asp-for="User" class="form-control" placeholder="Ej: jdoe" required />
                        <span asp-validation-for="User" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password" class="form-label no-select"></label>
                        <div class="input-container">
                            <input asp-for="Password" type="password" class="secure-password form-control" placeholder="Mín. 8 caracteres" required />
                            <button type="button" class="togglePassword btn-eye">👁</button>
                        </div>
                        <span asp-validation-for="Password"></span>
                    </div>
                    <div>
                        <label asp-for="Email" class="form-label no-select"></label>
                        <input asp-for="Email" class="form-control" placeholder="Ej: jdoe@demo.com" required />
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>
                    <div>
                        <label asp-for="Codigo" class="form-label no-select"></label>
                        <input asp-for="Codigo" class="form-control" placeholder="Ej: dga-jdoe" required />
                        <span asp-validation-for="Codigo" class="field-validation-error"></span>
                    </div>
                    <div>
                        <label asp-for="NombreCompleto" class="form-label no-select"></label>
                        <input asp-for="NombreCompleto" class="form-control" placeholder="Ej: jdoe" required />
                        <span asp-validation-for="NombreCompleto" class="field-validation-error"></span>
                    </div>

                    <div>
                        <label asp-for="RolId" class="form-label no-select">Rol</label>
                        <select asp-for="RolId"
                                asp-items="@(ViewBag.Roles as IEnumerable<SelectListItem>)"
                                class="form-select">
                            <option value="">-- Seleccione --</option>
                        </select>
                        <span class="input-help" id="no-select">Define los permisos del usuario.</span>
                        <span asp-validation-for="RolId" class="field-validation-error"></span>
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="Activo" class="form-check-input" type="checkbox" role="switch" id="switchActivo" />
                        <label for="switchActivo" class="form-check-label no-select labelEstado"></label>
                    </div>
                    <span asp-validation-for="Activo" class="text-danger"></span>
                </div>

                <div class="usuario-card__footer">
                    <a asp-action="Index" class="btn btn-cl">Cancelar</a>
                    <button type="submit" class="btn btn-gd">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/cuenta/CambioActividad.js"></script>
    <script src="~/js/cuenta/Ojo.js"></script>
}
