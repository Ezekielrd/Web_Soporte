@model IEnumerable<DGASoporte.Models.Solicitud>

@{
    ViewData["Title"] = "Lista de Solicitudes";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - DGASoporte</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link href="~/css/solicitudesC.css" rel="stylesheet" />
</head>
<body>
    <div class="container-fluid px-4 no-select">
        <div class="header-section">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h1 class="mb-1">
                        <i class="bi bi-list-check me-2"></i>
                        Mis Solicitudes
                    </h1>
                    <p class="text-muted mb-0">
                        Gestiona y organiza tus solicitudes de soporte técnico
                    </p>
                </div>

                <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end header-actions">
                    <span class="badge bg-primary d-inline-flex align-items-center header-date-badge"
                          style="font-size: 1rem; padding: 0.5rem 1rem;">
                        <i class="bi bi-calendar-event me-2"></i>
                        @DateTime.Now.ToString("dd/MM/yyyy")
                    </span>

                    <div class="notification-wrapper position-relative">
                        <button class="btn btn-outline-secondary btn-sm position-relative"
                                id="btnNotificaciones"
                                type="button">
                            <i class="bi bi-bell"></i>
                            <span id="badge-solicitudes"
                                  class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
                                  style="font-size:.65rem; display:none;">
                                0
                            </span>
                        </button>

                        <div id="panelNotificaciones" class="notif-dropdown shadow-sm">
                            <div class="notif-header d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-bell me-1"></i> Notificaciones</span>
                                <button type="button"
                                        id="btnCerrarNotif"
                                        class="btn btn-sm btn-link text-decoration-none text-muted">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                            <div id="notifList" class="notif-list">
                                <div class="notif-empty text-muted small text-center py-3">
                                    No tienes notificaciones aún.
                                </div>
                            </div>
                            <div class="notif-footer">
                                <button type="button"
                                        id="btnMarcarLeidas"
                                        class="btn btn-sm btn-light w-100">
                                    Marcar todas como leídas
                                </button>
                            </div>
                        </div>
                    </div>

                    <a href="@Url.Action("Logout", "Cuenta")"
                       id="btnLogout"
                       class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-2 logout-btn">
                        <span class="logout-icon-wrapper d-inline-flex align-items-center justify-content-center">
                            <i class="bi bi-box-arrow-right"></i>
                        </span>
                        <span class="logout-text">Cerrar sesión</span>
                    </a>
                </div>
            </div>
        </div>


        <!-- Tarjetas de Estadísticas -->
        <div class="row g-3 mb-4 tarjetas">
            <!-- Total -->
            <div class="col-12 col-sm-6 col-md-2">
                <div class="card text-white bg-primary h-100 shadow-sm">
                    <div class="card-body py-3 px-3">
                        <div class="d-flex justify-content-between align-items-center h-100">
                            <div class="flex-grow-1">
                                <h4 class="card-title mb-1 fw-bold">@ViewBag.TotalSolicitudes</h4>
                                <p class="card-text mb-0 small">Total</p>
                            </div>
                            <div class="ms-2">
                                <i class="fas fa-list" style="font-size: 1.8rem; opacity: 0.9;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Nuevas -->
            <div class="col-12 col-sm-6 col-md-2">
                <div class="card text-white bg-info h-100 shadow-sm">
                    <div class="card-body py-3 px-3">
                        <div class="d-flex justify-content-between align-items-center h-100">
                            <div class="flex-grow-1">
                                <h4 class="card-title mb-1 fw-bold">@ViewBag.EnviadaSolicitud</h4>
                                <p class="card-text mb-0 small">Enviadas</p>
                            </div>
                            <div class="ms-2">
                                <i class="fas fa-plus-circle" style="font-size: 1.8rem; opacity: 0.9;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- En Espera -->
            <div class="col-12 col-sm-6 col-md-2">
                <div class="card text-white bg-warning h-100 shadow-sm">
                    <div class="card-body py-3 px-3">
                        <div class="d-flex justify-content-between align-items-center h-100">
                            <div class="flex-grow-1">
                                <h4 class="card-title mb-1 fw-bold">@ViewBag.EnEsperaSolicitudes</h4>
                                <p class="card-text mb-0 small">En Espera</p>
                            </div>
                            <div class="ms-2">
                                <i class="fas fa-clock" style="font-size: 1.8rem; opacity: 0.9;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Aprobadas -->
            <div class="col-12 col-sm-6 col-md-2">
                <div class="card text-white bg-success h-100 shadow-sm">
                    <div class="card-body py-3 px-3">
                        <div class="d-flex justify-content-between align-items-center h-100">
                            <div class="flex-grow-1">
                                <h4 class="card-title mb-1 fw-bold">@ViewBag.AprobadaSolicitudes</h4>
                                <p class="card-text mb-0 small">Aprobadas</p>
                            </div>
                            <div class="ms-2">
                                <i class="fas fa-check-circle" style="font-size: 1.8rem; opacity: 0.9;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Rechazadas -->
            <div class="col-12 col-sm-6 col-md-2">
                <div class="card text-white bg-danger h-100 shadow-sm">
                    <div class="card-body py-3 px-3">
                        <div class="d-flex justify-content-between align-items-center h-100">
                            <div class="flex-grow-1">
                                <h4 class="card-title mb-1 fw-bold">@ViewBag.RechazadaSolicitudes</h4>
                                <p class="card-text mb-0 small">Rechazadas</p>
                            </div>
                            <div class="ms-2">
                                <i class="fas fa-times-circle" style="font-size: 1.8rem; opacity: 0.9;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filtros de Búsqueda -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0">
                        <i class="bi bi-funnel me-2 text-primary"></i> Filtros de búsqueda
                    </h5>
                    <small class="text-muted">Refina la lista de solicitudes</small>
                </div>
            </div>

            <div class="card-body p-3">
                <form id="filtrosSolicitudes" class="row g-3 align-items-end mb-0">
                    <div class="col-md-4">
                        <label for="estado" class="form-label small text-uppercase fw-semibold text-muted">
                            <i class="bi bi-flag me-1 text-primary"></i> Estado
                        </label>
                        <select class="form-select form-select-sm" id="estado" name="estado"
                                asp-items="@(ViewBag.Estados as IEnumerable<SelectListItem>)">
                            <option value="">Todos los estados</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label for="tipoId" class="form-label small text-uppercase fw-semibold text-muted">
                            <i class="bi bi-tags me-1 text-primary"></i> Tipo de incidencia
                        </label>
                        <select class="form-select form-select-sm" id="tipoId" name="tipoId"
                                asp-items="@(ViewBag.TiposIncidencia as IEnumerable<SelectListItem>)">
                            <option value="">Todos los tipos</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <div class="form-check form-switch mt-4">
                            <input class="form-check-input" type="checkbox" name="incluirArchivadas" value="true"
                                   id="chkArch" />
                            <label class="form-check-label small" for="chkArch">
                                Incluir archivadas
                            </label>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Contenedor de la tabla de solicitudes -->
        <div class="card shadow-sm border-0 tabla-solicitudes-wrapper">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0">
                        <i class="bi bi-ticket-perforated me-1 text-primary"></i> Solicitudes
                    </h5>
                    <small class="text-muted">
                        @Model.Count() registro(s)
                    </small>
                </div>

                <a asp-action="Create" class="btn btn-success btn-sm shadow-sm">
                    <i class="bi bi-file-earmark-text me-1"></i> Nueva solicitud
                </a>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-sm align-middle mb-0" id="tablaSolicitud">
                        <thead>
                            <tr>
                                <th class="col-titulo">Título</th>
                                <th class="col-descripcion">Descripción</th>
                                <th class="col-unidad">Unidad</th>
                                <th class="col-tipo">Tipo</th>
                                <th class="col-estado">Estado</th>
                                <th class="col-fecha">Creación</th>
                                <th class="col-acciones text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Any())
                            {
                                @foreach (var solicitud in Model)
                                {
                                    <tr>
                                        <td class="col-titulo">
                                            <strong>@solicitud.Titulo</strong>
                                        </td>

                                        <td class="col-descripcion">
                                            <span class="texto-2-lineas" title="@solicitud.Descripcion">
                                                @(solicitud.Descripcion.Length > 140
                                                                   ? solicitud.Descripcion.Substring(0, 140) + "..."
                                                                   : solicitud.Descripcion)
                                    </span>
                                </td>
                                        <td class="col-unidad">
                                            <span class="text-muted small">
                                                @solicitud.Unidad?.Nombre
                                            </span>
                                        </td>

                                        <td class="col-tipo">
                                            <span class="badge rounded-pill bg-light text-dark border small">
                                                @solicitud.TipoIncidencia?.Nombre
                                            </span>
                                        </td>

                                        <td class="col-estado">
                                             @if (solicitud.Estado == DGASoporte.Models.Enumeradores.EstadoS.Enviada)
                                                {
                                                    <span class="badge rounded-pill bg-primary small">Enviada</span>
                                                }
                                                else if (solicitud.Estado == DGASoporte.Models.Enumeradores.EstadoS.EnEspera)
                                                {
                                                    <span class="badge rounded-pill bg-warning text-dark small">En espera</span>
                                                }
                                                else if (solicitud.Estado == DGASoporte.Models.Enumeradores.EstadoS.Aprobada)
                                                {
                                                    <span class="badge rounded-pill bg-success small">Aprobada</span>
                                                }
                                                else if (solicitud.Estado == DGASoporte.Models.Enumeradores.EstadoS.Rechazada)
                                                {
                                                    <span class="badge rounded-pill bg-danger small">Rechazada</span>
                                                }
                                                else
                                                {
                                                    <span class="badge rounded-pill bg-secondary small">@solicitud.Estado</span>
                                                }
                                        </td>

                                        <td class="col-fecha">
                                            <span class="small text-muted">
                                                @solicitud.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
                                            </span>
                                        </td>

                                        <td class="col-acciones text-end">
                                            <div class="d-flex flex-wrap justify-content-end gap-1">
                                                <button type="button"
                                                        class="btn btn-outline-primary btn-accion btn-sm js-detalle-solicitud"
                                                        title="Ver detalle"
                                                        data-solicitud-id="@solicitud.Id"
                                                        data-titulo="@solicitud.Titulo"
                                                        data-descripcion="@solicitud.Descripcion"
                                                        data-unidad="@solicitud.Unidad?.Nombre"
                                                        data-Division="@solicitud.Division?.Nombre"
                                                        data-tipo="@solicitud.TipoIncidencia?.Nombre"
                                                        data-estado="@solicitud.Estado.ToString()">
                                                    <i class="bi bi-eye"></i>
                                                </button>

                                                @if (!solicitud.Archivada)
                                                {
                                                    <form asp-action="Archivar" asp-route-id="@solicitud.Id" method="post" class="d-inline">
                                                        <button class="btn btn-warning btn-accion btn-sm" type="submit" title="Archivar">
                                                            <i class="bi bi-archive"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">
                                        <i class="fas fa-inbox mb-2" style="font-size: 2rem;"></i>
                                        <div>No se encontraron solicitudes con los filtros aplicados.</div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div> 
        </div>

        <div class="modal fade" id="modalConfirmacion" tabindex="-1" aria-labelledby="modalConfirmacionLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalConfirmacionLabel">Detalle de la Solicitud</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-12">
                                <h6 class="text-primary mb-3" id="modalSubtitulo">
                                    Información de la solicitud seleccionada:
                                </h6>

                                <div class="card">
                                    <div class="card-body">
                                        <div class="row mb-3">
                                            <div class="col-sm-3">
                                                <strong>Título:</strong>
                                            </div>
                                            <div class="col-sm-9">
                                                <span id="modalTitulo" class="text-dark"></span>
                                            </div>
                                        </div>

                                        <div class="row mb-3">
                                            <div class="col-sm-3">
                                                <strong>Descripción:</strong>
                                            </div>
                                            <div class="col-sm-9">
                                                <span id="modalDescripcion" class="text-dark"></span>
                                            </div>
                                        </div>

                                        <div class="row mb-3">
                                            <div class="col-sm-3">
                                                <strong>Unidad:</strong>
                                            </div>
                                            <div class="col-sm-9">
                                                <span id="modalUnidad" class="text-dark"></span>
                                            </div>
                                        </div>

                                        <div class="row mb-3">
                                            <div class="col-sm-3">
                                                <strong>TipoIncidencia:</strong>
                                            </div>
                                            <div class="col-sm-9">
                                                <span id="modalTipo" class="text-dark"></span>
                                            </div>
                                        </div>

                                        <div class="row mb-3">
                                            <div class="col-sm-3">
                                                <strong>Estado</strong>
                                            </div>
                                            <div class="col-sm-9">
                                                <span id="modalEstado" class="text-dark"></span>
                                            </div>
                                        </div>
                                    </div> 
                                </div> 
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <!-- Como es solo detalle, puedes dejar solo el botón cerrar -->
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cerrar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/cliente/modal.js"></script>
    <!--datatable-->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <script src="~/js/cliente/filtrosCl.js"></script>

    <link rel="stylesheet" href="~/lib/sweetalert2/dist/sweetalert2.css" />
    <script src="~/lib/sweetalert2/dist/sweetalert2.js"></script>
    <script src="~/lib/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/notificaciones.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const params = new URLSearchParams(window.location.search);
            const solicitudId = params.get('solicitudId');  // viene de /Solicitudes?solicitudId=17

            if (!solicitudId) return;

            // función que busca el botón y dispara el click
            const abrirDesdeNotificacion = () => {
                const btn = document.querySelector(
                    `.js-detalle-solicitud[data-solicitud-id="${solicitudId}"]`
                );

                if (btn) {
                    btn.click(); // reutiliza tu JS global que abre el modal
                } else {
                    console.warn("No se encontró el botón de detalle para la solicitud", solicitudId);
                }
            };

            // Si usas DataTables (renderiza después), damos un pequeño margen
            if (window.jQuery && $.fn.DataTable) {
                setTimeout(abrirDesdeNotificacion, 400);
            } else {
                abrirDesdeNotificacion();
            }
        });
    </script>
    <script>
        (function () {
            const btnBell   = document.getElementById('btnNotificaciones');
            const panel     = document.getElementById('panelNotificaciones');
            const badge     = document.getElementById('badge-solicitudes');
            const list      = document.getElementById('notifList');
            const btnClose  = document.getElementById('btnCerrarNotif');
            const btnRead   = document.getElementById('btnMarcarLeidas');

            if (!btnBell || !panel) return;

            let unreadCount = 0;

            function actualizarBadge() {
                if (!badge) return;
                badge.textContent = unreadCount;
                badge.style.display = unreadCount > 0 ? 'inline-block' : 'none';
            }

            function togglePanel(show) {
                if (show === undefined) {
                    show = panel.style.display !== 'block';
                }
                panel.style.display = show ? 'block' : 'none';
            }

            btnBell.addEventListener('click', function (e) {
                e.stopPropagation();
                togglePanel();
            });

            btnClose?.addEventListener('click', function (e) {
                e.stopPropagation();
                togglePanel(false);
            });

            btnRead?.addEventListener('click', async function () {
                // 🔹 Lado UI
                unreadCount = 0;
                actualizarBadge();
                list.querySelectorAll('.notif-item.unread').forEach(el => {
                    el.classList.remove('unread');
                });

                // 🔹 Lado servidor (marcar en BD)
                try {
                    await fetch('/Notificaciones/MarcarTodasLeidas', {
                        method: 'POST',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                            // Si usas antiforgery:
                            // 'RequestVerificationToken': token
                        }
                    });
                } catch (err) {
                    console.error('Error marcando notificaciones como leídas', err);
                }
            });

            // Cerrar al hacer click fuera
            document.addEventListener('click', function (e) {
                if (!panel.contains(e.target) && !btnBell.contains(e.target)) {
                    togglePanel(false);
                }
            });

            // 🔹 Función: agregar una notificación a la lista
                    function formatearFecha(fecha) {
            try {
                const f = new Date(fecha);
                return f.toLocaleString('es-NI', {
                    year: 'numeric',
                    month: 'short',
                    day: '2-digit',
                    hour: '2-digit',
                    minute: '2-digit'
                });
            } catch {
                return "Ahora";
            }
        }

        function agregarNotif(notif) {
            if (!list) return;

            const empty = list.querySelector('.notif-empty');
            if (empty) empty.remove();

            const titulo  = notif.titulo  || notif.Titulo  || 'Notificación';
            const mensaje = notif.mensaje || notif.Mensaje || '';
            const url     = notif.urlDestino || notif.UrlDestino || notif.url || notif.Url || null;
            const fecha   = notif.fechaCreacion || notif.FechaCreacion;
            const leida   = notif.leida ?? notif.Leida ?? false;

            const item = document.createElement('div');
            item.className = 'notif-item';
            if (!leida) {
                item.classList.add('unread');
                unreadCount++;
                actualizarBadge();
            }

            item.innerHTML = `
                <div class="notif-item-title">${titulo}</div>
                <div class="notif-item-text">${mensaje}</div>
                <div class="notif-item-meta">
                    <i class="bi bi-clock me-1"></i> ${formatearFecha(fecha)}
                </div>
            `;

            item.addEventListener('click', function () {
                item.classList.remove('unread');
                if (!leida && unreadCount > 0) {
                    unreadCount--;
                    actualizarBadge();
                }

                if (url) window.location.href = url;
            });

            list.prepend(item);
        }


            // 🔹 Cargar notificaciones iniciales desde el servidor
                   async function cargarIniciales() {
            try {
                const resp = await fetch('/Notificaciones/Lista', {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });

                if (!resp.ok) return;

                const data = await resp.json();
                if (!Array.isArray(data) || data.length === 0) return;

                // limpiar mensaje vacío
                const empty = list.querySelector('.notif-empty');
                if (empty) empty.remove();

                unreadCount = 0;

                data.forEach(n => agregarNotif(n));
                actualizarBadge();
            } catch (err) {
                console.error('Error cargando notificaciones iniciales', err);
            }
        }


            // Exponer para usar desde notificaciones.js (SignalR)
            window.appNotificaciones = window.appNotificaciones || {};
            window.appNotificaciones.agregar = agregarNotif;

            // Cargar al entrar
            cargarIniciales();
        })();
    </script>
</body>
</html>


