@model IEnumerable<DGASoporte.Models.Usuario>
@{
    string q = (string)(ViewBag.Q ?? "");
}
<!DOCTYPE html>
<html lang="es">
    <head>
        <title>Lista de Usuario</title>
        <meta charset="UTF-8">
        <meta name="title" content="Lista de Usuarios">
        <meta name="description" content="todos los usuarios">
        <link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.5.2/css/bootstrap.css" rel="stylesheet" />
        <link href="https://cdn.datatables.net/2.3.4/css/dataTables.bootstrap4.min.css" rel="stylesheet" />
        <link href="~/css/Usuarios.css" rel="stylesheet" />
    </head>
<body>
    <section>
        <!-- Encabezado + botón agregar -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0">Usuarios</h3>
            <a asp-action="Create" class="btn btn-sm btn-agregar">+ Agregar</a>
        </div>
        <form method="get" class="d-flex align-items-center gap-2 mb-3">
            <div class="input-group input-group-sm busqueda-compacta">
                <input name="q" class="form-control" placeholder="Buscar por nombre..." value="@q" />
                <button class="btn btn-primary" type="submit">Buscar</button>
            </div>
            <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Limpiar</a>
        </form>
        <!-- Tabla -->
        <div class="table-responsive">
            <table class="table table-striped" id="example">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Email</th>
                        <th>Rol</th>
                        <th>Activo</th>
                        <th>Bloqueado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        var bloqueado = u.finBloqueo.HasValue && u.finBloqueo > DateTimeOffset.UtcNow;

                        <tr>
                            <td>@u.User</td>
                            <td>@u.Email</td>
                            <td>@u.Rol?.Nombre</td>
                            <td class="text-center">
                                <span class="badge @(u.Activo ? "bg-success" : "bg-secondary")">@(u.Activo ? "Sí" : "No")</span>
                            </td>
                            <td class="text-center">
                                <span class="badge @(bloqueado ? "bg-danger" : "bg-success")">@(bloqueado ? "Sí" : "No")</span>
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@u.Id">
                                    <i class="bi bi-eye"></i> Ver
                                </a>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@u.Id">
                                    <i class="bi bi-pencil-square"></i> Editar
                                </a>

                                <form asp-action="ToggleBloqueo" asp-route-id="@u.Id" method="post" class="d-inline">
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">
                                        <i class="bi @(bloqueado ? "bi-unlock" : "bi-lock")"></i> @(bloqueado ? "Desbloquear" : "Bloquear")
                                    </button>
                                    @Html.AntiForgeryToken()
                                </form>

                                <!-- Reset pass rápido con prompt -->
                                <form asp-action="ResetPassword" asp-route-id="@u.Id" method="post" class="d-inline resetPwdForm">
                                    <input type="hidden" name="newPassword" />
                                    <button type="button" class="btn btn-sm btn-outline-dark" onclick="openResetModal(this)" data-bs-toggle="modal" data-bs-target="#passwordResetModal">
                                        <i class="bi bi-key"></i> Reset pass
                                    </button>
                                    @Html.AntiForgeryToken()
                                </form>

                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@u.Id">
                                    <i class="bi bi-trash"></i> Eliminar
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
    <div class="modal fade" id="passwordResetModal" tabindex="-1" aria-labelledby="passwordResetModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="passwordResetModalLabel">Restablecer Contraseña</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Ingrese la nueva contraseña para el usuario:</p>
                    <input type="password" class="form-control" id="pwdInput" placeholder="Mínimo 8 caracteres">
                    <div class="text-danger mt-2 d-none" id="pwdError">Mínimo 6 caracteres requeridos.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" onclick="submitPasswordReset()">Guardar Cambios</button>
                </div>
            </div>
        </div>
    </div>
    @section Scripts {
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.3/umd/popper.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.5.2/js/bootstrap.min.js"></script>

        <!-- DataTables v2 (vanilla) + integración Bootstrap 4 -->
        <script src="https://cdn.datatables.net/2.3.4/js/dataTables.min.js"></script>
        <script src="https://cdn.datatables.net/2.3.4/js/dataTables.bootstrap4.min.js"></script>
        <!--script para inicializar datatable-->
        <script>
            $(function () {
              if (!$.fn.dataTable.isDataTable('#example')) {
                $('#example').DataTable({
                  searching: false,
                  language: { url: 'https://cdn.datatables.net/plug-ins/1.13.8/i18n/es-ES.json' }
                });
              }
            });
        </script>
        <script src="~/js/cuenta/Reseteo.js"></script>
        }
</body>
</html>