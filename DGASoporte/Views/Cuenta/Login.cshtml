@model DGASoporte.Models.UsuarioVM
@{
    Layout = null;
    ViewData["Title"] = "Iniciar sesión";
}

<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"] - Sistema Soporte</title>
    <link href="~/css/Login.css" rel="stylesheet" />
</head>
<body>
    <div class="login-contenedor">
        <!-- Columna ilustración -->
        <div class="portada no-select">
            <img src="~/img/soporte.png" alt="imagen soporte">
        </div>

        <!-- Columna formulario -->
        <div class="formulario">
            <div class="card">
                <div class="encabezado">
                    <div class="logo" aria-hidden="true">
                        <!-- ícono diente -->
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="currentColor" d="M12 21c-1.2 0-1.8-1.1-2.6-2.8c-.5-1.1-1.1-2.4-1.8-2.4c-.7 0-1.4.7-2.1 1.4l-.4.4c-.4.4-1 .4-1.4 0c-1.6-1.6-2.7-3.8-2.7-6.1C1 6.5 4.6 3 9 3h6c4.4 0 8 3.5 8 8c0 2.3-1 4.5-2.7 6.1c-.4.4-1 .4-1.4 0l-.4-.4c-.7-.7-1.4-1.4-2.1-1.4s-1.3 1.3-1.8 2.4C13.8 19.9 13.2 21 12 21Z" /></svg>
                    </div>
                    <div>
                        <h1 class="title no-select">Sistema Soporte Tecnico</h1>
                        <div class="subtitle no-select">Bienvenido al sistema de registro y control de tareas. Ingresa para comenzar.</div>
                    </div>
                </div>

                <form method="post" id="loginForm">

                    <div class="fld">
                        <label asp-for="User" class="no-select">Tu Usuario</label>
                        <div class="inp">
                            <!-- icono correo -->
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M2 6.5A2.5 2.5 0 0 1 4.5 4h15A2.5 2.5 0 0 1 22 6.5v11A2.5 2.5 0 0 1 19.5 20h-15A2.5 2.5 0 0 1 2 17.5v-11Zm2.5-.5a.5.5 0 0 0-.5.5v.38l8 4.8l8-4.8V6.5a.5.5 0 0 0-.5-.5h-15Zm15.5 3.62l-8 4.8l-8-4.8V17.5a.5.5 0 0 0 .5.5h15a.5.5 0 0 0 .5-.5V9.62Z" /></svg>
                            <input asp-for="User" autocomplete="username" placeholder="Ingrese su Usuario" id="usuario" required />
                        </div>
                        <span asp-validation-for="User" class="text-danger"></span>
                    </div>

                    <div class="fld">
                        <label asp-for="Password" class="no-select">Tu Contraseña</label>
                        <div class="input-container password-row">
                            <div class="inp">
                                <!-- candado -->
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24">
                                    <path d="M12 1a5 5 0 0 1 5 5v3h1.5A1.5 1.5 0 0 1 20 10.5v9A1.5 1.5 0 0 1 18.5 21h-13A1.5 1.5 0 0 1 4 19.5v-9A1.5 1.5 0 0 1 5.5 9H7V6a5 5 0 0 1 5-5Z" />
                                </svg>
                                <input asp-for="Password" id="contrasena" type="password" autocomplete="current-password" placeholder="Ingrese su Contraseña" />
                            </div>
                            <button type="button" id="togglePassword" class="toggle-password" hidden>👁</button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>


                    @*<div class="row-foot">
                        <label class="remember">
                            <input asp-for="Input.RememberMe" />
                            <span>Recordarme</span>
                        </label>
                        <a asp-page="./ForgotPassword">¿Olvidaste tu contraseña?</a>
                    </div>*@

                    <div style="margin-top:14px"></div>
                    <button class="btn" id="loginBtn" type="submit">Iniciar sesión</button>

                    @Html.AntiForgeryToken()
                </form>
            </div>
        </div>
    </div>
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- jQuery Validation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>

    <!-- Unobtrusive Validation (adapter de ASP.NET) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/cuenta/Error.js"></script>
    <script src="~/js/cuenta/Icono.js"></script>
    <script src="~/js/cuenta/Sacudida.js"></script>
</body>
</html>
