@model IEnumerable<DGASoporte.Models.Solicitud>

@{
    ViewData["Title"] = "Lista de Solicitudes";
}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
<div class="container-fluid px-4">
    <h1 class="mb-4 mt-3">Lista de Solicitudes</h1>

    <!-- Tarjetas de Estadísticas -->
    <div class="row g-3 mb-4">
        <!-- Total -->
        <div class="col-12 col-sm-6 col-md-2">
            <div class="card text-white bg-primary h-100 shadow-sm">
                <div class="card-body py-3 px-3">
                    <div class="d-flex justify-content-between align-items-center h-100">
                        <div class="flex-grow-1">
                            <h4 class="card-title mb-1 fw-bold">@ViewBag.TotalSolicitudes</h4>
                            <p class="card-text mb-0 small">Total</p>
                        </div>
                        <div class="ms-2">
                            <i class="fas fa-list" style="font-size: 1.8rem; opacity: 0.9;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Nuevas -->
        <div class="col-12 col-sm-6 col-md-2">
            <div class="card text-white bg-info h-100 shadow-sm">
                <div class="card-body py-3 px-3">
                    <div class="d-flex justify-content-between align-items-center h-100">
                        <div class="flex-grow-1">
                            <h4 class="card-title mb-1 fw-bold">@ViewBag.NuevasSolicitudes</h4>
                            <p class="card-text mb-0 small">Nuevas</p>
                        </div>
                        <div class="ms-2">
                            <i class="fas fa-plus-circle" style="font-size: 1.8rem; opacity: 0.9;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- En Espera -->
        <div class="col-12 col-sm-6 col-md-2">
            <div class="card text-white bg-warning h-100 shadow-sm">
                <div class="card-body py-3 px-3">
                    <div class="d-flex justify-content-between align-items-center h-100">
                        <div class="flex-grow-1">
                            <h4 class="card-title mb-1 fw-bold">@ViewBag.EnEsperaSolicitudes</h4>
                            <p class="card-text mb-0 small">En Espera</p>
                        </div>
                        <div class="ms-2">
                            <i class="fas fa-clock" style="font-size: 1.8rem; opacity: 0.9;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Aprobadas -->
        <div class="col-12 col-sm-6 col-md-2">
            <div class="card text-white bg-success h-100 shadow-sm">
                <div class="card-body py-3 px-3">
                    <div class="d-flex justify-content-between align-items-center h-100">
                        <div class="flex-grow-1">
                            <h4 class="card-title mb-1 fw-bold">@ViewBag.AprobadaSolicitudes</h4>
                            <p class="card-text mb-0 small">Aprobadas</p>
                        </div>
                        <div class="ms-2">
                            <i class="fas fa-check-circle" style="font-size: 1.8rem; opacity: 0.9;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Rechazadas -->
        <div class="col-12 col-sm-6 col-md-2">
            <div class="card text-white bg-danger h-100 shadow-sm">
                <div class="card-body py-3 px-3">
                    <div class="d-flex justify-content-between align-items-center h-100">
                        <div class="flex-grow-1">
                            <h4 class="card-title mb-1 fw-bold">@ViewBag.RechazadaSolicitudes</h4>
                            <p class="card-text mb-0 small">Rechazadas</p>
                        </div>
                        <div class="ms-2">
                            <i class="fas fa-times-circle" style="font-size: 1.8rem; opacity: 0.9;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- En Tarea -->
        <div class="col-12 col-sm-6 col-md-2">
            <div class="card text-white bg-secondary h-100 shadow-sm">
                <div class="card-body py-3 px-3">
                    <div class="d-flex justify-content-between align-items-center h-100">
                        <div class="flex-grow-1">
                            <h4 class="card-title mb-1 fw-bold">@ViewBag.EnTareaSolicitudes</h4>
                            <p class="card-text mb-0 small">En Tarea</p>
                        </div>
                        <div class="ms-2">
                            <i class="fas fa-tasks" style="font-size: 1.8rem; opacity: 0.9;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Formulario de Filtros -->
    <div class="card mb-5 shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0 py-2">Filtros de Búsqueda</h5>
        </div>
        <div class="card-body p-4">
            <form method="get" action="@Url.Action("Index")">
                <div class="row">
                    <div class="col-md-3">
                        <label for="search" class="form-label">Búsqueda</label>
                        <input type="text" class="form-control" id="search" name="search"
                               placeholder="Título, descripción, usuario..."
                               value="@ViewBag.CurrentSearch">
                    </div>
                    <div class="col-md-3">
                        <label for="estado" class="form-label">Estado</label>
                        <select class="form-select" id="estado" name="estado" asp-items="@(ViewBag.Estados as IEnumerable<SelectListItem>)">
                            <option value="">Todos lo Estados</option>
                        </select>
                        <script>
                            document.getElementById('estado').value = '@ViewBag.CurrentEstado';
                        </script>
                    </div>
                    <div class="col-md-3">
                        <label for="tipoId" class="form-label">Tipo de Incidencia</label>
                        <select class="form-select" id="tipoId" name="tipoId" asp-items="@(ViewBag.TiposIncidencia as IEnumerable<SelectListItem>)">
                            <option value="">Todos los tipos</option>
                        </select>
                        <script>
                            document.getElementById('tipoId').value = '@ViewBag.CurrentTipo';
                        </script>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <div class="w-100">
                            <button type="submit" class="btn btn-primary me-2">
                                <i class="fas fa-search"></i> Buscar
                            </button>
                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Limpiar
                            </a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Botón Nueva Solicitud -->
    <div class="mb-4">
        <a asp-action="Create" class="btn btn-success btn-lg shadow-sm">
            <i class="bi bi-file-earmark-plus"></i> Nueva Solicitud
        </a>
    </div>

    <!-- Tabla de Solicitudes -->
    <div class="table-responsive">
        <table class="table table-striped table-hover shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Título</th>
                    <th>Descripción</th>
                    <th>Usuario</th>
                    <th>Unidad</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>Fecha Creación</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var solicitud in Model)
                    {
                        <tr>
                            <td>@solicitud.Id</td>
                            <td><strong>@solicitud.Titulo</strong></td>
                            <td>@(solicitud.Descripcion.Length > 100 ? solicitud.Descripcion.Substring(0, 100) + "..." : solicitud.Descripcion)</td>
                            <td>@solicitud.Usuario?.NombreCompleto</td>
                            <td>@solicitud.Unidad?.Nombre</td>
                            <td>
                                <span class="badge bg-light text-dark">@solicitud.TipoIncidencia?.Nombre</span>
                            </td>
                            <td>
                                @if (solicitud.Estado == DGASoporte.Models.Enumeradores.EstadoS.Nueva)
                                {
                                    <span class="badge bg-primary">Nueva</span>
                                }
                                else if (solicitud.Estado == DGASoporte.Models.Enumeradores.EstadoS.EnEspera)
                                {
                                    <span class="badge bg-warning">En Espera</span>
                                }
                                else if (solicitud.Estado == DGASoporte.Models.Enumeradores.EstadoS.Aprobada)
                                {
                                    <span class="badge bg-success">Aprobada</span>
                                }
                                else if (solicitud.Estado == DGASoporte.Models.Enumeradores.EstadoS.Rechazada)
                                {
                                    <span class="badge bg-danger">Rechazada</span>
                                }
                                else if (solicitud.Estado == DGASoporte.Models.Enumeradores.EstadoS.ConvertidaEnTarea)
                                {
                                    <span class="badge bg-info">Convertida en Tarea</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@solicitud.Estado</span>
                                }
                            </td>
                            <td>@solicitud.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted">
                            <i class="fas fa-inbox" style="font-size: 2rem; margin-bottom: 1rem;"></i>
                            <br>
                            No se encontraron solicitudes con los filtros aplicados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Información de resultados -->
    @if (Model.Any())
    {
        <div class="alert alert-info mb-4">
            <i class="fas fa-info-circle me-2"></i>
            Mostrando @Model.Count() solicitud(es)
            @if (!string.IsNullOrEmpty(ViewBag.CurrentSearch) || ViewBag.CurrentEstado != null || ViewBag.CurrentTipo != null && ViewBag.CurrentTipo.HasValue)
            {
                <span>con los filtros aplicados</span>
            }
        </div>
    }

</div> <!-- Fin del container-fluid -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>