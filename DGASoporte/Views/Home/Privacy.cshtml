@using DGASoporte.Models.Enumeradores
@model TareaFormVM

@{
    ViewData["Title"] = "Nueva Tarea";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
<link href="~/css/privacidad.css" rel="stylesheet" />

<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="card wizard-card">
                <div class="card-body p-4 p-md-5">
                    <div class="wizard-header d-flex align-items-center">
                        <div class="wizard-icon-circle">
                            <i class="bi bi-kanban fs-5"></i>
                        </div>
                        <div>
                            <h3 class="mb-0">Nueva Tarea</h3>
                            <div class="wizard-subtitle">
                                Completa los pasos para registrar una tarea de soporte.
                            </div>
                        </div>
                        <div class="ms-auto d-none d-md-block">
                            <span class="badge-soft">
                                <i class="bi bi-shield-check me-1"></i> Soporte Técnico
                            </span>
                        </div>
                    </div>

                    <!-- STEPPER -->
                    <div class="stepper-wrapper">
                        <div class="stepper-item active" data-step-indicator="1">
                            <div class="step-counter">1</div>
                            <div class="step-name">Información</div>
                        </div>
                        <div class="stepper-item" data-step-indicator="2">
                            <div class="step-counter">2</div>
                            <div class="step-name">Asignación</div>
                        </div>
                        <div class="stepper-item" data-step-indicator="3">
                            <div class="step-counter">3</div>
                            <div class="step-name">Fechas</div>
                        </div>
                        <div class="stepper-item" data-step-indicator="4">
                            <div class="step-counter">4</div>
                            <div class="step-name">Resumen</div>
                        </div>
                    </div>

                    <form asp-action="Create" method="post" id="wizardForm" novalidate>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                        @* Campos ocultos *@
                        <input asp-for="Id" type="hidden" />
                        <input asp-for="RowVersion" type="hidden" />
                        <input asp-for="FechaCreacion" type="hidden" />

                        <!-- PASO 1: Información básica -->
                        <div class="form-step active" data-step="1">
                            <div class="mb-3">
                                <label asp-for="Titulo" class="form-label"></label>
                                <input asp-for="Titulo" class="form-control" />
                                <span asp-validation-for="Titulo" class="invalid-feedback"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Descripcion" class="form-label"></label>
                                <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                                <div class="form-text">Describe el problema, impacto y contexto.</div>
                                <span asp-validation-for="Descripcion" class="invalid-feedback"></span>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="CategoriaId" class="form-label"></label>
                                    <select asp-for="CategoriaId" asp-items="Model.Categorias" class="form-select">
                                        <option value="">-- Seleccione --</option>
                                    </select>
                                    <span asp-validation-for="CategoriaId" class="invalid-feedback"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Prioridad" class="form-label"></label>
                                    <select asp-for="Prioridad" class="form-select">
                                        @foreach (var item in Html.GetEnumSelectList<Prioridad>())
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    </select>
                                    <span asp-validation-for="Prioridad" class="invalid-feedback"></span>
                                </div>
                            </div>
                        </div>

                        <!-- PASO 2: Unidad y técnico -->
                        <div class="form-step" data-step="2">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="DivisionId" class="form-label"></label>
                                    <select asp-for="DivisionId"
                                            asp-items="Model.Divisiones"
                                            class="form-select" id="DivisionId">
                                        <option value="">-- Seleccione división --</option>
                                    </select>
                                    <span asp-validation-for="DivisionId" class="text-danger"></span>
                                </div>

                                <div class="col-md-6" id="grupoUnidad">
                                    <label asp-for="UnidadId" class="form-label"></label>
                                    <select asp-for="UnidadId" class="form-select" id="UnidadId">
                                        <option value="">-- Seleccione unidad --</option>

                                        @* Cada unidad lleva data-division con su DivisionId (o vacío si no tiene) *@
                                        @foreach (var u in Model.Unidades)
                                        {
                                            var divisionId = u.DivisionId.HasValue ? u.DivisionId.Value.ToString() : "";
                                            <option value="@u.Id"
                                                    data-division="@divisionId">
                                                @u.Nombre
                                            </option>
                                        }
                                    </select>
                                    <span asp-validation-for="UnidadId" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="TecnicoId" class="form-label">Técnico (opcional)</label>
                                    <select asp-for="TecnicoId" asp-items="Model.Tecnicos" class="form-select">
                                        <option value="">-- Sin asignar --</option>
                                    </select>
                                    <span asp-validation-for="TecnicoId" class="invalid-feedback"></span>
                                </div>
                            </div>

                            <div class="d-flex gap-2 mt-3">
                                <span class="tag-pill">
                                    <i class="bi bi-exclamation-circle"></i>
                                    Puedes dejar el técnico sin asignar y hacerlo más tarde.
                                </span>
                            </div>

                            <div class="mt-3">
                                <label asp-for="Estado" class="form-label"></label>
                                <select asp-for="Estado" class="form-select">
                                    @foreach (var item in Html.GetEnumSelectList<EstadoT>())
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                </select>
                                <span asp-validation-for="Estado" class="invalid-feedback"></span>
                            </div>

                            <div class="form-check form-switch mt-3">
                                <input asp-for="Archivada" class="form-check-input" />
                                <label asp-for="Archivada" class="form-check-label">
                                    Marcar como archivada
                                </label>
                            </div>
                        </div>

                        <!-- PASO 3: Fechas -->
                        <div class="form-step" data-step="3">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="FechaLimite" class="form-label"></label>
                                    <input asp-for="FechaLimite" class="form-control" type="date" />
                                    <span asp-validation-for="FechaLimite" class="invalid-feedback"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="FechaAsignacion" class="form-label">Fecha de asignación</label>
                                    <input asp-for="FechaAsignacion" class="form-control" type="date" />
                                    <span asp-validation-for="FechaAsignacion" class="invalid-feedback"></span>
                                </div>
                            </div>

                            <div class="mt-3">
                                <div class="tag-pill">
                                    <i class="bi bi-clock-history"></i>
                                    La fecha de creación se genera automáticamente:
                                    <strong>@Model.FechaCreacion.ToString("dd/MM/yyyy")</strong>
                                </div>
                            </div>
                        </div>

                        <!-- PASO 4: Resumen -->
                        <div class="form-step" data-step="4">
                            <div class="mb-3">
                                <h5 class="mb-2">
                                    <i class="bi bi-clipboard2-check me-2"></i>
                                    Revisión final
                                </h5>
                                <p class="wizard-subtitle mb-0">
                                    Verifica que la información sea correcta antes de guardar.
                                </p>
                            </div>

                            <div class="border rounded-3 p-3 mb-3" style="background: rgba(15,23,42,.75);">
                                <div class="d-flex justify-content-between mb-2">
                                    <div>
                                        <div class="text-muted small">Título</div>
                                        <div id="resumenTitulo" class="fw-semibold"></div>
                                    </div>
                                    <span class="badge-soft" id="resumenPrioridad"></span>
                                </div>
                                <hr class="border-secondary-subtle" />
                                <div class="small text-muted mb-1">Descripción</div>
                                <div id="resumenDescripcion" class="small"></div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <div class="border rounded-3 p-3 h-100" style="background: rgba(15,23,42,.75);">
                                        <div class="small text-muted mb-1">Unidad</div>
                                        <div id="resumenUnidad" class="fw-semibold"></div>
                                        <div class="small text-muted mt-2">Categoría</div>
                                        <div id="resumenCategoria" class="small"></div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="border rounded-3 p-3 h-100" style="background: rgba(15,23,42,.75);">
                                        <div class="small text-muted mb-1">Técnico</div>
                                        <div id="resumenTecnico" class="small"></div>
                                        <div class="small text-muted mt-2">Estado</div>
                                        <div id="resumenEstado" class="small"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="border rounded-3 p-3" style="background: rgba(15,23,42,.75);">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="small text-muted mb-1">Creación</div>
                                        <div>@Model.FechaCreacion.ToString("dd/MM/yyyy")</div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="small text-muted mb-1">Límite</div>
                                        <div id="resumenFechaLimite"></div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="small text-muted mb-1">Asignación</div>
                                        <div id="resumenFechaAsignacion"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- BOTONES -->
                        <div class="d-flex justify-content-between mt-4">
                            <button type="button" class="btn btn-outline-light d-none" id="btnPrev">
                                <i class="bi bi-arrow-left-circle me-1"></i> Anterior
                            </button>

                            <div class="ms-auto d-flex gap-2">
                                <button type="button" class="btn btn-gradient-primary" id="btnNext">
                                    Siguiente <i class="bi bi-arrow-right-circle ms-1"></i>
                                </button>

                                <button type="submit" class="btn btn-success d-none" id="btnSubmit">
                                    <i class="bi bi-check2-circle me-1"></i> Guardar tarea
                                </button>
                            </div>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const totalSteps = 4;
            let currentStep = 1;

            const form = document.getElementById('wizardForm');
            const btnNext = document.getElementById('btnNext');
            const btnPrev = document.getElementById('btnPrev');
            const btnSubmit = document.getElementById('btnSubmit');

            const stepPanels = document.querySelectorAll('.form-step');
            const stepIndicators = document.querySelectorAll('[data-step-indicator]');

            function showStep(step) {
                currentStep = step;

                // Mostrar/ocultar paneles
                stepPanels.forEach(p => {
                    const panelStep = parseInt(p.getAttribute('data-step'));
                    p.classList.toggle('active', panelStep === step);
                });

                // Actualizar stepper
                stepIndicators.forEach(ind => {
                    const indStep = parseInt(ind.getAttribute('data-step-indicator'));
                    ind.classList.toggle('active', indStep === step);
                    ind.classList.toggle('completed', indStep < step);
                });

                // Botones
                btnPrev.classList.toggle('d-none', step === 1);
                btnNext.classList.toggle('d-none', step === totalSteps);
                btnSubmit.classList.toggle('d-none', step !== totalSteps);

                if (step === totalSteps) {
                    actualizarResumen();
                }
            }

            function validarStepActual() {
                // Valida solo los campos del paso actual con HTML5
                const currentPanel = document.querySelector('.form-step[data-step="' + currentStep + '"]');
                const inputs = currentPanel.querySelectorAll('input, select, textarea');

                let esValido = true;

                inputs.forEach(input => {
                    if (!input.checkValidity()) {
                        esValido = false;
                        input.classList.add('is-invalid');
                    } else {
                        input.classList.remove('is-invalid');
                    }
                });

                return esValido;
            }

            function actualizarResumen() {
                const titulo = document.getElementById('Titulo');
                const descripcion = document.getElementById('Descripcion');
                const prioridad = document.getElementById('Prioridad');
                const categoria = document.getElementById('CategoriaId');
                const unidad = document.getElementById('UnidadId');
                const tecnico = document.getElementById('TecnicoId');
                const estado = document.getElementById('Estado');
                const fechaLimite = document.getElementById('FechaLimite');
                const fechaAsignacion = document.getElementById('FechaAsignacion');

                document.getElementById('resumenTitulo').innerText = titulo.value || 'Sin título';
                document.getElementById('resumenDescripcion').innerText = descripcion.value || 'Sin descripción';

                const prioridadText = prioridad.options[prioridad.selectedIndex]?.text || 'Sin prioridad';
                document.getElementById('resumenPrioridad').innerText = prioridadText;

                const unidadText = unidad.options[unidad.selectedIndex]?.text || 'Sin unidad';
                document.getElementById('resumenUnidad').innerText = unidadText;

                const categoriaText = categoria.options[categoria.selectedIndex]?.text || 'Sin categoría';
                document.getElementById('resumenCategoria').innerText = categoriaText;

                const tecnicoText = tecnico.value ? (tecnico.options[tecnico.selectedIndex]?.text) : 'Sin técnico asignado';
                document.getElementById('resumenTecnico').innerText = tecnicoText;

                const estadoText = estado.options[estado.selectedIndex]?.text || 'Sin estado';
                document.getElementById('resumenEstado').innerText = estadoText;

                document.getElementById('resumenFechaLimite').innerText = fechaLimite.value || 'No definida';
                document.getElementById('resumenFechaAsignacion').innerText = fechaAsignacion.value || 'No definida';
            }

            btnNext.addEventListener('click', function () {
                if (!validarStepActual()) {
                    return;
                }
                if (currentStep < totalSteps) {
                    showStep(currentStep + 1);
                }
            });

            btnPrev.addEventListener('click', function () {
                if (currentStep > 1) {
                    showStep(currentStep - 1);
                }
            });

            // Inicial
            showStep(1);
        })();
    </script>
}
