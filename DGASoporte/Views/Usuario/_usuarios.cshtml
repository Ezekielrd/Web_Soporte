@model IEnumerable<DGASoporte.Models.Usuario>

<link href="~/css/Usuarios.css" rel="stylesheet" asp-append-version="true"/>

<div class="container-fluid">
    <div class="toast-container">
        @if (TempData["Success"] != null)
        {
            <div class="toast-msg toast-success">
                <span class="toast-icon">✔</span>
                <span>@TempData["Success"]</span>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="toast-msg toast-error">
                <span class="toast-icon">⚠</span>
                <span>@TempData["Error"]</span>
            </div>
        }

        @if (TempData["Alert"] != null)
        {
            <div class="toast-msg toast-alert">
                <span class="toast-icon">ℹ</span>
                <span>@TempData["Alert"]</span>
            </div>
        }
    </div>
    <!-- Encabezado + botón agregar -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="mb-0 no-select">Usuarios</h3>
        <a asp-action="Create"
           asp-controller="Usuario"
           class=" no-select js-modal-link" id="btn-success-usuario">
            <i class="bi bi-plus-circle"></i> Nuevo Usuario
        </a>
    </div>
    <!-- Tabla -->
    <div class="table-responsive">
        <table class="table table-striped" id="tablaUsuarios">
            <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Codigo</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th>Activo</th>
                    <th>Bloqueado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    var bloqueado = u.finBloqueo.HasValue && u.finBloqueo > DateTimeOffset.UtcNow;

                    <tr>
                        <td>@u.Usher</td>
                        <td>@u.Codigo</td>
                        <td>@u.Email</td>
                        <td>@u.Rol?.Nombre</td>
                        <td class="text-center">
                            <span class="badge @(u.Activo ? "bg-success" : "bg-secondary")">@(u.Activo ? "Sí" : "No")</span>
                        </td>
                        <td class="text-center">
                            <span class="badge @(bloqueado ? "bg-danger" : "bg-success")">@(bloqueado ? "Sí" : "No")</span>
                        </td>
                        <td class="text-end">
                            <div class="acciones-usuario d-flex flex-wrap justify-content-end gap-1">
                                <a class="btn btn-sm btn-outline-info js-modal-link" asp-action="Details" asp-controller="Usuario" asp-route-id="@u.Id">
                                    <i class="bi bi-eye"></i> Ver
                                </a>
                                <a class="btn btn-sm btn-outline-primary js-modal-link" asp-action="Edit" asp-controller="Usuario" asp-route-id="@u.Id">
                                    <i class="bi bi-pencil-square"></i> Editar
                                </a>

                                <form asp-action="ToggleBloqueo"
                                      asp-controller="Usuario"
                                      asp-route-id="@u.Id"
                                      method="post"
                                      class="d-inline"
                                      data-ajax-bloqueo-usuario="true">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">
                                        <i class="bi @(bloqueado ? "bi-unlock" : "bi-lock")"></i>
                                        @(bloqueado ? "Desbloquear" : "Bloquear")
                                    </button>
                                </form>

                                <a class="btn btn-sm btn-outline-danger js-modal-link" asp-action="Delete" asp-controller="Usuario" asp-route-id="@u.Id">
                                    <i class="bi bi-trash"></i> Eliminar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="bi bi-people"></i>
                <p>No hay usuarios registrados</p>
            </div>
        }
    </div>
    <div class="modal fade" id="passwordResetModal" tabindex="-1" aria-labelledby="passwordResetModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="passwordResetModalLabel">Restablecer Contraseña</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Ingrese la nueva contraseña para el usuario:</p>
                    <input type="password" class="form-control" id="pwdInput" placeholder="Mínimo 8 caracteres">
                    <div class="text-danger mt-2 d-none" id="pwdError">Mínimo 6 caracteres requeridos.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" onclick="submitPasswordReset()">Guardar Cambios</button>
                </div>
            </div>
        </div>
    </div>
 </div>