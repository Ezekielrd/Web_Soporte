@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Panel Administrador</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN"
          crossorigin="anonymous">
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link href="~/css/Home.css" rel="stylesheet" />
</head>
<body>

    <!-- Sidebar -->
    <aside class="sidebar collapsed" id="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-brand">
                <i class="bi bi-kanban"></i>
                <div class="sidebar-title">
                    <h2>TaskAdmin</h2>
                    <p>Panel de Administración</p>
                </div>
            </div>

            <!--botón para colapsar/expandir -->
            <button id="btnToggleSidebar" class="btn-toggle-sidebar" type="button">
                <i class="bi bi-chevron-double-right"></i>
            </button>
        </div>
        <nav class="sidebar-menu">
            <a href="#" class="menu-item active" data-view="Tareas" data-url="@Url.Action("Index", "Tarea")"title="Tareas">
                <i class="bi-list-task"></i><span>Tareas</span>
            </a>
            <a href="#" class="menu-item" data-view="Dashboard" data-url="@Url.Action("Index", "Dashboard")" title="Tareas">
                <i class="i bi-grid-fill"></i><span>Dashboard</span>
            </a>
            <a href="#" class="menu-item" data-view="Usuarios" data-url="@Url.Action("Index", "Usuario")" title="Usuarios">
                <i class="bi bi-people-fill"></i><span>Usuarios</span>
            </a>
            <a href="#" class="menu-item" data-view="Solicitudes" data-url="@Url.Action("Index", "AdminSolicitudes")"title="Solicitudes">
                <i class="bi-envelope-fill"></i><span>Solicitudes</span>
            </a>
        </nav>
    </aside>

    <!-- Contenido -->
    <main class="main-content" id="mainContent">
        <div class="top-bar">
            <h1 class="no-select"><i class="bi bi-speedometer2"></i> Panel de Administración</h1>

            <div class="top-bar-actions">
                <div class="header-actions d-flex align-items-center gap-2">

                    <!-- Reloj -->
                    <span class="badge text-bg-light no-select">
                        <i class="bi bi-calendar-event"></i>
                        <span id="reloj-header"></span>
                    </span>

                    <div class="notification-wrapper position-relative">
                        <button id="btnNotificaciones"
                                type="button"
                                class="btn btn-link nav-link position-relative p-0">
                            <i class="bi bi-bell fs-5"></i>
                            <span id="notifBadge"
                                  class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">
                                0
                            </span>
                        </button>

                        <!-- Panel flotante -->
                        <div id="notifPanel"
                             class="card shadow border-0 position-absolute end-0 mt-2 d-none"
                             style="width: 340px; z-index: 1050;">
                            <div class="card-header d-flex justify-content-between align-items-center py-2">
                                <div>
                                    <i class="bi bi-bell me-1"></i>
                                    <span>Notificaciones</span>
                                </div>
                                <button type="button"
                                        class="btn-close btn-close-sm"
                                        aria-label="Cerrar"
                                        id="btnCerrarNotif"></button>
                            </div>
                            <div class="list-group list-group-flush small" id="notifList">
                                <div class="list-group-item text-muted text-center py-3" id="notifPlaceholder">
                                    Cargando...
                                </div>
                            </div>
                            <div class="card-footer text-center">
                                <form id="formMarcarLeidas"
                                      method="post"
                                      asp-controller="Notificaciones"
                                      asp-action="MarcarTodasComoLeidas">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-link btn-sm text-decoration-none">
                                        Marcar todas como leídas
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end">
                        <a href="@Url.Action("Logout", "Cuenta")"
                           id="btnLogout"
                           class="btn btn-outline-danger btn-sm d-inline-flex align-items-center gap-2 logout-btn">
                            <span class="logout-icon-wrapper d-inline-flex align-items-center justify-content-center">
                                <i class="bi bi-box-arrow-right"></i>
                            </span>
                            <span class="logout-text">Cerrar sesión</span>
                        </a>
                    </div>

                </div>
            </div>
        </div>


        <div id="view-container">
            @* contenido inicial *@
        </div>
    </main>
    <!--modal-->
    <div class="modal fade" id="appModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 bg-transparent p-0 modal-dark-form">
                <!-- Bootstrap necesita esta capa con .modal-body para el scroll -->
                <div class="modal-body p-0" id="appModalBody">
                    <!-- aquí se inyecta el <div class="usuario-card"> ... -->
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <!-- jQuery y validación DESDE wwwroot/lib -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

        <!--datatable-->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    <script src="~/js/tareas.js" asp-append-version="true"></script>

        <!--boostrap-->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
       
        <script src="~/js/panel/sidebar.js"></script>
        <script src="~/js/panel/modalGneral.js"></script>
         <script src="~/js/panel/reloj.js"></script>

    <link rel="stylesheet" href="~/lib/sweetalert2/dist/sweetalert2.css" />
    <script src="~/lib/sweetalert2/dist/sweetalert2.js"></script>
    <script src="~/lib/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/notificaciones.js" asp-append-version="true"></script>
    <script src="~/js/cliente/campana.js"></script>
    <script>
        (function () {

            // 🔹 1. Cuando carga Home/Index, si viene de notificación, disparar el menú "Solicitudes"
            document.addEventListener('DOMContentLoaded', function () {
                const params      = new URLSearchParams(window.location.search);
                const view        = params.get('view');     
                const solicitudId = params.get('solicitudId');   // id que viene desde notificación
                const tareaId      = params.get('tareaId');


                 console.log('🏁 Home/Index DOMContentLoaded. view=', view, 'solicitudId=', solicitudId, 'tareaId=', tareaId);

                if (view === 'Solicitudes' && solicitudId) {
                    // Guardamos el id para usarlo después de cargar el parcial
                    window._solicitudIdDesdeNotificacion = solicitudId;

                         // ✅ fuerza el módulo correcto para que el autoload NO lo pise
                    try { localStorage.setItem('adminLastView', 'Solicitudes'); } catch {}

                    const menuSolicitudes = document.querySelector(
                        '.sidebar-menu .menu-item[data-view="Solicitudes"]'
                    );

                    if (menuSolicitudes) {
                        console.log('👉 Haciendo click en menú Solicitudes desde notificación...');
                        menuSolicitudes.click();
                    } else {
                        console.warn('❗ No se encontró el menú de Solicitudes.');
                    }
                }
                if (view === 'Tareas' && tareaId) {
                    window._tareaIdDesdeNotificacion = tareaId;
                    const menuTareas = document.querySelector('.sidebar-menu .menu-item[data-view="Tareas"]');
                    if (menuTareas) {
                        console.log('👉 Click en menú Tareas (desde notificación)');
                        menuTareas.click();
                    }
                }
            });

            window.onTareasViewLoaded = function () {
                // 1) Recuperar el id desde la variable global o desde la URL
                let id = window._tareaIdDesdeNotificacion;
                if (!id) {
                    const params = new URLSearchParams(window.location.search);
                    id = params.get('tareaId');
                }

                console.log('🎯 onTareasViewLoaded() llamado. id =', id);
                if (!id) return;

                // 2) Construir la URL del detalle de la tarea
                const url = `/Tarea/Details/${id}`;

                // 3) Crear un <a> oculto con la clase js-modal-link
                const fakeLink = document.createElement('a');
                fakeLink.href = url;
                fakeLink.className = 'js-modal-link';
                fakeLink.style.display = 'none';

                document.body.appendChild(fakeLink);

                console.log('🔗 Lanzando click en enlace fantasma para abrir modal de tarea', id);

                // 4) Simular clic → lo captura modalGeneral.js y abre el modal como siempre
                fakeLink.click();

                // 5) Limpiar
                setTimeout(() => {
                    fakeLink.remove();
                }, 0);

                window._tareaIdDesdeNotificacion = null;
            };

            window.onSolicitudesViewLoaded = function () {
                let id = window._solicitudIdDesdeNotificacion;

                if (!id) {
                    const params = new URLSearchParams(window.location.search);
                    id = params.get('solicitudId');
                }

                console.log('🎯 onSolicitudesViewLoaded() id =', id);
                if (!id) return;

                const selector = `.js-modal-link[data-solicitud-id="${id}"]`;

                let attempts = 0;
                const maxAttempts = 12;   // 12 intentos
                const delayMs = 250;      // cada 250ms

                const timer = setInterval(() => {
                    attempts++;

                    const btn = document.querySelector(selector);
                    console.log(`🔎 Solicitudes intento ${attempts}: ${selector} ->`, !!btn);

                    if (btn) {
                        // ✅ abrir usando tu modalGeneral.js
                        btn.click();
                        clearInterval(timer);
                        window._solicitudIdDesdeNotificacion = null;
                    }

                    if (attempts >= maxAttempts) {
                        console.warn('❗ No se encontró el botón para abrir el modal de solicitud', id);
                        clearInterval(timer);
                    }
                }, delayMs);
            };

        })();
    </script>
    <script src="~/js/solicitudes.js"></script>
    <script src="~/js/tareas.js"></script>
    <script src="~/js/usuarios.js"></script>
    <script src="~/js/cuenta/usuarios-password-edit.js"></script>
    <script src="~/js/solicitudes.js"></script>
    <script src="~/js/chart.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>

</body>
</html>
