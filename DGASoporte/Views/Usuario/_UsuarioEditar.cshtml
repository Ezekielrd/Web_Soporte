@model UsuarioVM
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    Layout = null;
}
<link href="~/css/cardUsaurio.css" rel="stylesheet" />
<div asp-validation-summary="All" class="text-danger"></div>

    <div class="usuario-card">
        <div class="usuario-card__bar"></div>

        <div class="usuario-card__header">
            <div>
                <h3 class="usuario-create-title" id="no-select">Editar usuario</h3>
                <div class="usuario-create-sub" id="no-select">Actualiza datos y (si deseas) la contraseña.</div>
            </div>
            <a href="#" class="link-back js-close-modal">Volver</a>
        </div>

        <div class="usuario-card__body">
        <form asp-action="Edit" method="post" class="form-edicion" id="formUsuario" data-ajax-usuario="true" asp-route-id="@Model.Id" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" id="EsEdicion" value="true" />

                <div class="form-section grid-2">
                    <div>
                        <label asp-for="Usher" class="form-label"></label>
                        <input asp-for="Usher" class="form-control" placeholder="Ej: jdoe" required />
                        <span asp-validation-for="Usher" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="Ej: jdoe" required />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="Codigo" class="form-label"></label>
                        <input asp-for="Codigo" class="form-control" placeholder="Ej: jdoe" required />
                        <span asp-validation-for="Codigo" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="NombreCompleto" class="form-label"></label>
                        <input asp-for="NombreCompleto" class="form-control" placeholder="Ej: jdoe" required />
                        <span asp-validation-for="NombreCompleto" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="RolId" class="form-label"></label>
                        <select asp-for="RolId" asp-items="Model.Roles" class="form-select" id="IdRol">
                            <option value="">-- Seleccione --</option>
                        </select>
                        <span class="input-help" id="no-select">Define los permisos del usuario.</span>
                        <span asp-validation-for="RolId" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="input-container">
                            <input asp-for="Password" class="secure-password form-control" placeholder="Dejar en blanco para mantener" />
                            <button type="button" class="togglePassword">👁</button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <!--campos propios del técnico-->
                    <div id="panelTecnico" style="display:none;">
                        <label asp-for="NivelId" class="form-label"></label>
                        <select asp-for="NivelId" asp-items="Model.Niveles" class="form-select">
                            <option value="">-- Seleccione --</option>
                        </select>
                        <span class="input-help" id="no-select">Define el niivel del tecnico.</span>
                        <span asp-validation-for="NivelId" class="text-danger"></span>
                    </div>

                </div>
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="Activo" class="form-check-input" type="checkbox" role="switch" id="switchActivo" />
                        <label for="switchActivo" class="form-check-label no-select labelEstado"></label>
                    </div>
                    <span asp-validation-for="Activo" class="text-danger"></span>
                </div>

                <div class="usuario-card__footer">
                    <a href="#" class="usuarioM-btn usuarioM-btn-cl js-close-modal">Cancelar</a>
                    <button type="submit" class="usuarioM-btn usuarioM-btn-gd">Guardar</button>
                </div>
            </form>
        </div>
    </div>


