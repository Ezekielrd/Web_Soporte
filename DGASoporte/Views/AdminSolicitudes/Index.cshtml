@using DGASoporte.Models.Enumeradores
@model IEnumerable<Solicitud>

@{
    ViewData["Title"] = "Gestión de Solicitudes de Soporte";
}

    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />


<div class="container-fluid px-4 mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0"><i class="bi bi-ticket-perforated"></i> Bandeja de Solicitudes</h4>
            <span id="countBadge" class="badge bg-light text-primary fs-6">@Model.Count()</span>
        </div>

        <div class="card-body">
            <table id="tblSolicitudes" class="table table-striped table-hover w-100">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Título</th>
                        <th>Usuario</th>
                        <th>Unidad</th>
                        <th>Tipo</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th width="120">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr data-id="@s.Id">
                            <td>@s.Id</td>
                            <td class="text-truncate" style="max-width:180px;" title="@s.Titulo">@s.Titulo</td>
                            <td>@s.Usuario.NombreCompleto</td>
                            <td>@s.Unidad.Nombre</td>
                            <td>@s.TipoIncidencia.Nombre</td>
                            <td>@s.FechaCreacion.ToString("g")</td>
                            <td>
                                @{
                                    var badge = s.Estado switch
                                    {
                                        EstadoS.EnEspera => "warning",
                                        EstadoS.Enviada => "info",
                                        EstadoS.Aprobada => "success",
                                        EstadoS.Rechazada => "danger",
                                        _ => "secondary"
                                    };
                                }
                                <span class="badge bg-@badge estado-badge">@s.Estado</span>
                            </td>
                            <td class="text-end d-flex gap-2">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@s.Id" title="Ver"><i class="bi bi-eye"></i></a>
                                <form asp-action="Aprobar" method="post">
                                    <input type="hidden" name="id" value="@s.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-success d-inline" title="Aprovar">
                                        <i class="bi bi-check-circle-fill"></i>
                                    </button>
                                    @Html.AntiForgeryToken()
                                </form>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Evaluar" asp-route-id="@s.Id" title="Rechazar"><i class="bi bi-x-circle-fill"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Rechazar -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Rechazar Solicitud</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="rejectForm">
                <div class="modal-body">
                    <input type="hidden" id="rejectId" />
                    <div class="mb-2">
                        <label class="form-label">Motivo del rechazo</label>
                        <textarea class="form-control" id="rejectReason" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Confirmar rechazo</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        $(function () {
            const table = $('#tblSolicitudes').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
                },
                order: [[0, 'desc']],
                columnDefs: [{ orderable: false, targets: 7 }]
            });

            // Cambiar estado vía AJAX
            $('.cambiar-estado').on('click', function (e) {
                e.preventDefault();
                const id = $(this).data('id');
                const estado = $(this).data('estado');
                $.post('@Url.Action("CambiarEstado")', { id, estado }, function () {
                    toastr.success('Estado actualizado');
                    location.reload();
                });
            });

            // Rechazar
            let rejectId = 0;
            $('.reject-btn').on('click', function () {
                rejectId = $(this).data('id');
                $('#rejectId').val(rejectId);
                $('#rejectModal').modal('show');
            });

            $('#rejectForm').on('submit', function (e) {
                e.preventDefault();
                const reason = $('#rejectReason').val();
                $.post('@Url.Action("Rechazar")', { id: rejectId, motivo: reason }, function () {
                    toastr.success('Solicitud rechazada');
                    $('#rejectModal').modal('hide');
                    location.reload();
                });
            });
        });
    </script>
}