@using DGASoporte.Models.Enumeradores
@model dynamic

@{
    ViewData["Title"] = "Asignar Tarea";
    var tarea = Model.Tarea as Tarea;
    var tecnicos = Model.Tecnicos as IEnumerable<Tecnico> ?? Enumerable.Empty<Tecnico>();
    var niveles = Model.Niveles as IEnumerable<Nivel> ?? Enumerable.Empty<Nivel>();

}

<h2>Asignar Tarea</h2>
<div class="form-section grid-2">
    <div>
        <dt>Usuario</dt>
        <dd>@tarea?.Titulo</dd>
    </div>
    <div>
        <dt>Correo</dt>
        <dd>@tarea?.Prioridad.ToString()</dd>
    </div>
    <form asp-action="Asignar" method="post">

        @Html.AntiForgeryToken()
        <input type="hidden" name="tareaId" value="@tarea.Id" />

        <div class="row g-3">

            <div class="mb-3">
                <label for="nivelSelect" class="form-label">
                    <i class="bi bi-layer-backward"></i> Nivel
                </label>
                <select id="nivelSelect" class="form-select filter-input">
                    <option value="">Todos los niveles</option>
                    @foreach (var n in niveles)
                    {
                        <option value="@n.Id">@n.Nombre</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label for="tecnicoSelect" class="form-label">
                    <i class="bi bi-person"></i> Técnico
                </label>
                <select id="tecnicoSelect" class="form-select filter-input" name="tecnicoId">
                    <option value="">Todos los técnicos</option>
                    @foreach (var t in tecnicos)
                    {
                        var cant = t.TareasAsignadas.Count(ta => ta.Estado == EstadoT.EnProceso);
                        <option value="@t.Id"
                                data-cant="@cant" data-nivel="@t.Nivel?.Id">
                            @t.Usuario.NombreCompleto (@cant sin cerrar)
                        </option>
                    }
                </select>
                <!-- Badge dinámico -->
                <span id="tecnicoBadge" class="badge mt-1"></span>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check2-circle"></i> Asignar
            </button>
        </div>
    </form>
</div>

       
        <form asp-action="AsignarAuto"
              asp-controller="Tareas"
              method="post"
              class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="tareaId" value="@tarea.Id" />
            <button type="submit" class="btn btn-sm btn-outline-success">
                Auto
            </button>
        </form>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const select = document.getElementById('tecnicoSelect');
        const badge  = document.getElementById('tecnicoBadge');

        function actualizarBadge() {
            const opt = select.selectedOptions[0];
            if (!opt.value) {
                badge.textContent = '';
                badge.className = 'badge mt-1';
                return;
            }

            const cant = parseInt(opt.dataset.cant, 10);
            badge.textContent = cant + ' sin cerrar';

            // colores
            if (cant === 0) {
                badge.className = 'badge bg-success mt-1';
            } else if (cant <= 5) {
                badge.className = 'badge bg-warning text-dark mt-1';
            } else {
                badge.className = 'badge bg-danger mt-1';
            }
        }

        select.addEventListener('change', actualizarBadge);
        actualizarBadge(); // inicial
    });
</script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const nivelSel  = document.getElementById('nivelSelect');
        const tecnicoSel = document.getElementById('tecnicoSelect');

        nivelSel.addEventListener('change', () => {
            const nivelId = nivelSel.value;

            Array.from(tecnicoSel.options).forEach(opt => {
                // el primer option (todos) siempre se muestra
                if (!opt.value) {
                    opt.hidden = false;
                    return;
                }

                const optNivel = opt.dataset.nivel;
                // si no hay nivel elegido mostramos todos
                if (!nivelId) {
                    opt.hidden = false;
                } else {
                    opt.hidden = optNivel !== nivelId;
                }
            });

            // si el técnico actual ya no es válido, reseteamos
            if (tecnicoSel.selectedOptions[0].hidden) {
                tecnicoSel.value = '';
            }
        });
    });
</script>