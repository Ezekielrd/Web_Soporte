@using DGASoporte.Models
@using DGASoporte.Models.Enumeradores
@model TareaAsignarVM

@{
    Layout = null;
}
<link href="~/css/asiganar.css" rel="stylesheet" />
<div class="card-modern">
    <h2 class="mb-4" style="font-size: 1.5rem; color: #007bff;">Asignar Tarea</h2>

    <div class="row mb-3">
        <div class="col-4">
            <strong>Tarea:</strong>
            <div class="text-muted">@Model.Tarea.Titulo</div>
        </div>
        <div class="col-4">
            <strong>Prioridad:</strong>
            <div class="text-muted">@Model.Tarea.Prioridad.ToString()</div>
        </div>
        <div class="col-4">
            <strong>Unidad:</strong>
            <div class="text-muted">@Model.Tarea.Unidad.Nombre</div>
        </div>
    </div>

    <form asp-action="Asignar" method="post" data-ajax-tarea="true">
        @Html.AntiForgeryToken()
        <input type="hidden" name="tareaId" value="@Model.Tarea.Id" />

        <div class="mb-3">
            <label for="nivelSelect" class="form-label">
                <i class="bi bi-layer-backward"></i> Nivel
            </label>
            <select id="nivelSelect" class="form-select filter-input">
                <option value="">Todos los niveles</option>
                @foreach (var n in Model.Niveles)
                {
                    <option value="@n.Id">@n.Nombre</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="TecnicoId" class="form-label">
                <i class="bi bi-person"></i> @Html.DisplayNameFor(m => m.TecnicoId)
            </label>

            <select asp-for="TecnicoId" class="form-select filter-input" id="tecnicoSelect">
                <option value="" selected disabled>Seleccione un técnico</option>
                @foreach (var t in Model.Tecnicos)
                {
                    var cant = t.TareasAsignadas.Count();
                    <option value="@t.Id"
                            data-cant="@cant"
                            data-nivel="@t.Nivel?.Id">
                        @t.Usuario.NombreCompleto (@cant Tareas Asig)
                    </option>
                }
            </select>
            <span asp-validation-for="TecnicoId" class="text-danger"></span>
        </div>


        <div class="d-flex justify-content-end gap-2 mt-4">
            <button type="button" class="btn btn-secondary js-close-modal" data-bs-dismiss="modal">
                Cancelar
            </button>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check2-circle"></i> Asignar
            </button>
        </div>
    </form>

    <form asp-action="AsignarAuto"
          asp-controller="Tarea"
          method="post"
          data-ajax-tarea="true"
          class="mt-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="tareaId" value="@Model.Tarea.Id" />
        <button type="submit" class="btn btn-outline-success auto-btn">
            🔄 Asignación Automática
        </button>
    </form>


</div>
