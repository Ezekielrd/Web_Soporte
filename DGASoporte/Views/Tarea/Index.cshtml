@model IEnumerable<DGASoporte.Models.Tarea>
@{
    ViewData["Title"] = "Tareas";
    var filtros = ViewBag.Filtros;
}
<link href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.5.2/css/bootstrap.css" rel="stylesheet" />
<link href="https://cdn.datatables.net/2.3.4/css/dataTables.bootstrap4.css" rel="stylesheet" />

<h2 class="mb-3">Tareas</h2>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-2">
        <select name="estadoId" class="form-select" asp-items="@(ViewBag.Estados as IEnumerable<SelectListItem>)">
            <option value="">-- Estado --</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="prioridadId" class="form-select" asp-items="@(ViewBag.Prioridades as IEnumerable<SelectListItem>)">
            <option value="">-- Prioridad --</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="unidadId" class="form-select" asp-items="@(ViewBag.Unidades as IEnumerable<SelectListItem>)">
            <option value="">-- Unidad --</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="unidadId" class="form-select" asp-items="@(ViewBag.Categorias as IEnumerable<SelectListItem>)">
            <option value="">-- Categoria --</option>
        </select>
    </div>
    <div class="col-md-2 form-check d-flex align-items-center gap-2">
        <input class="form-check-input" type="checkbox" name="incluirArchivadas" value="true" id="chkArch" />
        <label class="form-check-label" for="chkArch">Incluir archivadas</label>
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button class="btn btn-primary w-100" type="submit">Filtrar</button>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Limpiar</a>
    </div>
</form>

<p>
    <a class="btn btn-success" asp-action="Create">
        <i class="bi bi-person-plus"></i> Nuevo usuario
    </a>
</p>

<table class="table table-striped table-bordered" id="example">
    <thead>
        <tr>
            <th>Título</th>
            <th>Estado</th>
            <th>Prioridad</th>
            <th>Unidad</th>
            <th>Fecha Límite</th>
            <th>Archivada</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var t in Model)
        {
            var rowClass = t.Vencida ? "table-danger" : "";
            <tr class="@rowClass">
                <td>@t.Titulo</td>
                <td>@t.Estado?.Nombre</td>
                <td>@t.Prioridad?.Nombre</td>
                <td>@t.Unidad?.Nombre</td>
                <td>@t.FechaLimite</td>
                <td>@(t.Archivada ? "Sí" : "No")</td>
                <td class="text-end text-nowrap">
                    <div class="d-inline-flex gap-2 align-items-center flex-nowrap">
                        <a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@t.Id">
                            <i class="bi bi-eye"></i> Ver
                        </a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@t.Id">
                            <i class="bi bi-pencil-square"></i> Editar
                        </a>
                        @if (!t.Archivada)
                        {
                            <form asp-action="Archivar" asp-route-id="@t.Id" method="post" class="d-inline">
                                <button class="btn btn-sm btn-warning" type="submit">Archivar</button>
                            </form>
                        }
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@t.Id">
                            <i class="bi bi-trash"></i> Eliminar
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
          new DataTable('#example', {
            language: {
              url: 'https://cdn.datatables.net/plug-ins/2.1.4/i18n/es-ES.json'
            }
          });
        });
    </script>

    <script src="https://code.jquery.com/jquery-3.7.1.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.3/umd/popper.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/2.3.4/js/dataTables.bootstrap4.js"></script>
}