@model dynamic
@using DGASoporte.Models.Enumeradores;
@{
    Layout = null;
    ViewData["Title"] = "Administración de Tareas";

    var tareas = Model.Tareas as IEnumerable<Tarea> ?? Enumerable.Empty<Tarea>();
    var tecnicos = Model.Tecnicos as IEnumerable<Tecnico> ?? Enumerable.Empty<Tecnico>();
    var tiposervicio = Model.TipoServicio as IEnumerable<TipoServicio> ?? Enumerable.Empty<TipoServicio>();
    var categorias = Model.Categorias as IEnumerable<Categoria> ?? Enumerable.Empty<Categoria>();
    var unidades = Model.Unidades as IEnumerable<Unidad> ?? Enumerable.Empty<Unidad>();
    var niveles = Model.Niveles as IEnumerable<Nivel> ?? Enumerable.Empty<Nivel>();
}
<link href="~/css/Principal.css" rel="stylesheet" asp-append-version="true" />
<div class="toast-container">
    @if (TempData["Success"] != null)
    {
        <div class="toast-msg toast-success">
            <span class="toast-icon">✔</span>
            <span>@TempData["Success"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="toast-msg toast-error">
            <span class="toast-icon">⚠</span>
            <span>@TempData["Error"]</span>
        </div>
    }
    @if (TempData["Alert"] != null)
    {
        <div class="toast-msg toast-alert">
            <span class="toast-icon">ℹ</span>
            <span>@TempData["Alert"]</span>
        </div>
    }
</div>
<!-- Stats -->
<div class="dashboard-stats-tareas no-select">
    <div class="stat-box-tareas primary">
        <div class="stat-content-tareas">
            <div class="stat-info-tareas">
                <h3 id="totalTasks">@tareas.Count()</h3>
                <p>Total de Tareas</p>
            </div>
            <i class="bi bi-list-check stat-icon-tareas"></i>
        </div>
    </div>
    <div class="stat-box-tareas danger">
        <div class="stat-content-tareas">
            <div class="stat-info-tareas">
                <h3 id="overdueTasks">@tareas.Count(t => t.Estado?.ToString()=="EnEspera")</h3>
                <p>En Espera</p>
            </div>
            <i class="bi bi-exclamation-triangle stat-icon-tareas"></i>
        </div>
    </div>
    <div class="stat-box-tareas warning">
        <div class="stat-content-tareas">
            <div class="stat-info-tareas">
                <h3 id="pendingTasks">@tareas.Count(t => t.Estado?.ToString() == "EnProceso")</h3>
                <p>Pendientes</p>
            </div>
            <i class="bi bi-clock-history stat-icon-tareas"></i>
        </div>
    </div>
    <div class="stat-box-tareas success">
        <div class="stat-content-tareas">
            <div class="stat-info-tareas">
                <h3 id="completedTasks">@tareas.Count(t => t.Estado?.ToString() == "Resuelta")</h3>
                <p>Completadas</p>
            </div>
            <i class="bi bi-check-circle stat-icon-tareas"></i>
        </div>
    </div>
</div>

<!-- Técnicos -->
<div class="technicians-panel no-select">
    <div class="panel-header">
        <h2><i class="bi bi-people"></i> Técnicos Disponibles</h2>
        <a href="@Url.Action("Create", "Usuario", new { rolId = 2 })" class="btn-new-tarea js-modal-link" style="font-size:.85rem;padding:.5rem 1rem">
            <i class="bi bi-person-plus"></i> Agregar Técnico
        </a>
    </div>
    <div class="technicians-grid">
        @foreach (var tecnico in tecnicos)
        {
            var tareasAsignadas = tareas.Count(t => t.TecnicoId == tecnico.Id && !t.Archivada);
            var tareasCompletadas = tareas.Count(t => t.TecnicoId == tecnico.Id && t.Estado?.GetDisplayName()=="Resuelta");
            var tareasPendientes = tareas.Count(t => t.TecnicoId == tecnico.Id && t.Estado?.GetDisplayName() == "En Proceso");
            var statusClass = tareasAsignadas == 0 ? "available" : (tareasAsignadas > 5 ? "overloaded" : "busy");
            <div class="tech-card @statusClass" data-tech-id="@tecnico.Id">
                <div class="tech-header">
                    <div class="tech-avatar">@(tecnico.Usuario.NombreCompleto?.Substring(0, 1) ?? "T")</div>
                    <div class="tech-info">
                        <h4>@tecnico.Usuario.NombreCompleto</h4>
                        <p>@tecnico.Usuario.Email</p>
                        <p style="font-size:.7rem;opacity:.9;margin-top:.2rem">
                            <i class="bi bi-award"></i> @tecnico.Nivel?.Nombre
                        </p>
                        <div class="d-flex align-items-center gap-2">
                            @{
                                // 1. Contar las tareas NO archivadas y asignar a una variable
                                var tareasActivas = tecnico.TareasAsignadas.Count(t => !t.Archivada);
                                // 2. Determinar la condición: Disponible si NO tiene tareas activas (tareasActivas == 0)
                                var estaDisponible = (tareasActivas == 0);
                            }

                            <span class="badge estado-disponibilidad@(estaDisponible ? "bg-success" : "bg-warning")" style="font-size:.6rem">
                                @(estaDisponible ? "Disponible" : "No disponible")
                            </span>

                            <span class="badge tareas-count bg-primary" style="font-size:.6rem">
                                @tareasActivas tareas
                            </span>
                        </div>
                    </div>
                </div>
                <div class="tech-stats">
                    <div class="tech-stat">
                        <div class="tech-stat-value js-tech-asignadas">@tareasAsignadas</div>
                        <div class="tech-stat-label">Asignadas</div>
                    </div>
                    <div class="tech-stat">
                        <div class="tech-stat-value js-tech-pendientes">@tareasPendientes</div>
                        <div class="tech-stat-label">Pendientes</div>
                    </div>
                    <div class="tech-stat">
                        <div class="tech-stat-value js-tech-completadas">@tareasCompletadas</div>
                        <div class="tech-stat-label">Completadas</div>
                    </div>
                </div>
            </div>
        }
        @if (!tecnicos.Any())
        {
            <div class="empty-state" style="grid-column:1/-1">
                <i class="bi bi-person-x"></i>
                <p>No hay técnicos registrados</p>
            </div>
        }
    </div>
</div>
<!--filtros-->
<div class="filters-panel">
    <div class="filters-grid-2">
        <!-- Técnico -->
        <div class="filter-group">
            <label><i class="bi bi-person"></i> Técnico</label>
            <select id="filterTecnico" class="filter-input">
                <option value="">Todos los técnicos</option>
                @foreach (var t in tecnicos)
                {
                    <option value="@t.Id">@t.Usuario.NombreCompleto</option>
                }
            </select>
        </div>
        <!-- Estado -->
        <div class="filter-group">
            <label><i class="bi bi-circle-fill"></i> Estado</label>
            <select id="filterEstado" class="filter-input">
                <option value="">Todos los estados</option>
                @foreach (EstadoT e in Enum.GetValues(typeof(EstadoT)))
                {
                    var value = e.ToString().ToLower(); 
                   <option value="@value">@e.GetDisplayName()</option>
                }
            </select>
        </div>
        <!-- Prioridad -->
        <div class="filter-group">
            <label><i class="bi bi-flag"></i> Prioridad</label>
            <select id="filterPrioridad" class="filter-input">
                <option value="">Todas las prioridades</option>
                @foreach (Prioridad p in Enum.GetValues(typeof(Prioridad)))
                {
                    var value = p.ToString().ToLower();
                    <option value="@value">@p.GetDisplayName()</option>
                }
            </select>
        </div>
        <!-- Categoria -->
        <div class="filter-group">
            <label><i class="bi-list"></i> Categoria</label>
            <select id="filterCategoria" class="filter-input">
                <option value="">Todas las Categorias</option>
                @foreach (var c in categorias)
                {
                    <option value="@c.Id">@c.Nombre</option>
                }
            </select>
        </div>
        <!-- Semana -->
        <div class="filter-group">
            <label><i class="bi bi-calendar-week"></i> Semana</label>
            <select id="filterSemana" class="filter-input"></select>
            <small class="text-muted">Rango: últimos 30 días</small>
        </div>
        <!-- Día -->
        <div class="filter-group">
            <label><i class="bi bi-calendar-day"></i> Día</label>
            <select id="filterDia" class="filter-input"></select>
            <small class="text-muted">Días dentro de la semana</small>
        </div>
    </div>

    <div class="quick-filters no-select">
        <button class="quick-filter-btn active" data-filter="all" type="button">Todas</button>
        <button class="quick-filter-btn" data-filter="vencidas" type="button">Vencidas</button>
        <button class="quick-filter-btn" data-filter="sin-asignar" type="button">Sin Asignar</button>
        <button class="quick-filter-btn" data-filter="hoy" type="button">Vencen Hoy</button>
    </div>
</div>



<!-- Tabla -->
<div class="tasks-panel no-select">
    <div class="panel-header">
        <h2><i class="bi bi-table"></i> Gestión de Tareas</h2>
        <div>
            <a href="@Url.Action("Create", "Tarea")"
               class="btn-new-tarea js-modal-link">
                <i class="bi-check2-square"></i> Nueva Tarea
            </a>
        </div>
    </div>

    <div style="overflow-x:auto">
        <div class="table-responsive">
            <table class="tasks-table table-striped" id="tablaTareas">
                <thead>
                    <tr>
                        <th>Título</th>
                        <th>Prioridad</th>
                        <th>Estado</th>
                        <th>Técnico</th>
                        <th>Unidad</th>
                        <th>Categoria</th>
                        <th>Fecha Creacion</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tarea in tareas.OrderByDescending(t => t.FechaCreacion))
                    {
                        var prioridadClass = tarea.Prioridad.ToString().ToLower() ?? "baja";
                        var estadoClass = tarea.Estado?.ToString().ToLower() ?? "pendiente";

                        <tr class="task-row"
                            data-prioridad="@prioridadClass"
                            data-estado="@estadoClass"
                            data-tecnico="@tarea.TecnicoId"
                            data-categoria="@tarea.CategoriaId"
                            data-unidad="@tarea.UnidadId"
                            data-fecha="@tarea.FechaCreacion.ToString("yyyy-MM-dd")"
                            data-vencida="@(tarea.Vencida ? "true" : "false")">
                            
                            <td>
                                <div class="task-title-cell">@tarea.Titulo</div>
                                @if (tarea.Vencida)
                                {
                                    <span class="task-overdue">
                                        <i class="bi bi-exclamation-circle"></i> Vencida
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="task-priority priority-@prioridadClass">
                                    <i class="bi bi-flag-fill"></i> @tarea.Prioridad.GetDisplayName()
                                </span>
                            </td>
                            <td>
                                <span class="task-status status-@estadoClass">
                                    <i class="bi bi-circle-fill"></i> @tarea.Estado?.GetDisplayName()
                                </span>
                            </td>
                            <td>
                                @if (tarea.Tecnico != null)
                                {
                                    <div class="tech-badge">
                                        <div class="tech-avatar-small">
                                            @tarea.Tecnico.Usuario.NombreCompleto.Substring(0, 1).ToUpper()
                                        </div>
                                        @tarea.Tecnico.Usuario.NombreCompleto
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">Sin asignar</span>
                                }
                            </td>
                            <td>@tarea.Unidad?.Nombre</td>
                            <td>@tarea.Categoria?.Nombre</td>
                            <td>
                                <div>@tarea.FechaCreacion</div>
                                <small class="text-muted">@tarea.FechaLimite</small>
                            </td>
                            <td>
                                <div class="action-btns">
                                    <a class="btn-action details js-modal-link" data-tarea-id="@tarea.Id"
                                       title="Detalle"
                                       asp-action="Details" asp-controller="Tarea" asp-route-id="@tarea.Id">
                                        <i class="bi-card-text"></i>
                                    </a>
                                    <a class="btn-action edit js-modal-link"
                                       title="Editar"
                                       asp-action="Edit" asp-controller="Tarea" asp-route-id="@tarea.Id">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if(!tarea.TecnicoId.HasValue && tarea.Estado==EstadoT.Nuevo)
                                    {
                                        <a class="btn-action assign js-modal-link"
                                           title="Asignar"
                                           asp-action="Asignar" asp-controller="Tarea" asp-route-id="@tarea.Id">
                                            <i class="bi bi-person-plus"></i>
                                        </a>
                                    }
                                    @if(tarea.TecnicoId.HasValue && tarea.Estado==EstadoT.EnEspera)
                                    {
                                        <a class="btn-action assign js-modal-link"
                                           title="ReAsignar"
                                           asp-action="Asignar" asp-controller="Tarea" asp-route-id="@tarea.Id">
                                            <i class="bi bi-person-plus"></i>
                                        </a>
                                    }
                                    <a class="btn-action delete js-modal-link"
                                       title="Eliminar"
                                       asp-action="Delete" asp-controller="Tarea" asp-route-id="@tarea.Id">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                    @if (tarea.Estado == EstadoT.Resuelta || tarea.Estado == EstadoT.EnEspera)
                                    {
                                        <a asp-controller="Reportes"
                                           asp-action="ReporteIncidencia"
                                           asp-route-id="@tarea.Id"
                                           title="Reporte"
                                           class="btn-action reporte">
                                            <i class="bi bi-file-earmark-text me-1"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!tareas.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <h3>No hay tareas registradas</h3>
                    <p>Crea una nueva tarea para comenzar</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal de Confirmación de Eliminación -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle me-2"></i>Confirmar Eliminación
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">¿Estás seguro de que deseas eliminar la siguiente tarea?</p>
                <div class="alert alert-warning">
                    <strong id="modalTareaTitulo"></strong>
                </div>
                <p class="text-danger mb-0">
                    <i class="bi bi-info-circle me-1"></i>
                    <small>Esta acción no se puede deshacer.</small>
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>Cancelar
                </button>
                <button type="button" class="btn btn-danger" id="confirmDelete">
                    <i class="bi bi-trash me-1"></i>Eliminar Tarea
                </button>
            </div>
        </div>
    </div>
</div>
