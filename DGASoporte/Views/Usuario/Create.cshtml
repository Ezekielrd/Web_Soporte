@model DGASoporte.Models.UsuarioVM
@using Microsoft.AspNetCore.Mvc.Rendering

<div class="usuario-create-page">
    <div class="usuario-create-card">
        <div class="usuario-create-card__bar"></div>

        <div class="usuario-create-card__header">
            <div>
                <h3 class="usuario-create-title" id="no-select">Agregar usuario</h3>
                <div class="usuario-create-sub" id="no-select">Crea una cuenta con rol y contraseña seguras</div>
            </div>
            <a asp-action="Index" class="link-back">Volver</a>
        </div>

        <div class="usuario-create-card__body">
            <form asp-action="Create" method="post" id="formCambiarContrasena" novalidate>
                @Html.AntiForgeryToken()

                <div class="form-section grid-2">
                    <div>
                        <label asp-for="User" class="form-label"></label>
                        <input asp-for="User" class="form-control" placeholder="Ej: jdoe" required />
                        <span asp-validation-for="User" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for=" Password" class="form-label"></label>
                        <div class="input-container">
                            <input asp-for=" Password" type="password" class="secure-password form-control" placeholder="Mín. 8 caracteres" required />
                            <button type="button" class="togglePassword">👁</button>
                        </div>
                        <span asp-validation-for=" Password" class="field-validation-error"></span>
                    </div>

                    <div>
                        <label asp-for="NombreCompleto" class="form-label"></label>
                        <input asp-for="NombreCompleto" class="form-control" placeholder="Ej: jdoe" required />
                        <span asp-validation-for="NombreCompleto" class="field-validation-error"></span>
                    </div>

                    <div>
                        <label asp-for="RolId" class="form-label">Rol</label>
                        <select asp-for="RolId"
                                asp-items="@(ViewBag.Roles as IEnumerable<SelectListItem>)"
                                class="form-select">
                            <option value="">-- Seleccione --</option>
                        </select>
                        <span class="input-help" id="no-select">Define los permisos del usuario.</span>
                        <span asp-validation-for="RolId" class="field-validation-error"></span>
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-check form-switch">
                        <input asp-for="Activo" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="Activo" class="form-check-label"></label>
                    </div>
                    <span asp-validation-for="Activo" class="text-danger"></span>
                </div>

                <div class="usuario-create-card__footer">
                    <a asp-action="Index" class="btn btn-ghost">Cancelar</a>
                    <button type="submit" class="btn btn-brand">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
