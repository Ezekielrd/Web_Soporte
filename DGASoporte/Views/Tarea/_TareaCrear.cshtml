@using DGASoporte.Models.Enumeradores
@model TareaFormVM
@using System.Text.Json

@{
    // Mapeo id/nombre para JS
    var usuariosJson = JsonSerializer.Serialize(
        Model.Usuarios.Select(u => new { id = u.Value, nombre = u.Text })
    );
}
@{
    Layout = null; // importante: que no meta el layout dentro del modal
}
<link href="~/css/cardTarea.css" rel="stylesheet" />
<div class="wizard-card-tarea no-select">
    <div class="card-body-tarea p-4 p-md-4">
        <div class="wizard-header-tarea d-flex align-items-center">
            <div class="wizard-icon-circle">
                <i class="bi bi-kanban fs-5"></i>
            </div>
            <div>
                <h3 class="mb-0">Nueva Tarea</h3>
                <div class="wizard-subtitle">
                    Completa los pasos para registrar una tarea de soporte.
                </div>
            </div>
            <div class="ms-auto d-none d-md-block">
                <span class="badge-soft">
                    <i class="bi bi-shield-check me-1"></i> Soporte Técnico
                </span>
            </div>
        </div>

        <!-- STEPPER -->
        <div class="stepper-wrapper">
            <div class="stepper-item active" data-step-indicator="1">
                <div class="step-counter">1</div>
                <div class="step-name">INFORMACIÓN</div>
            </div>
            <div class="stepper-item" data-step-indicator="2">
                <div class="step-counter">2</div>
                <div class="step-name">DETALLES</div>
            </div>
            <div class="stepper-item" data-step-indicator="3">
                <div class="step-counter">3</div>
                <div class="step-name">ASIGNACION</div>
            </div>
            <div class="stepper-item" data-step-indicator="4">
                <div class="step-counter">4</div>
                <div class="step-name">RESUMEN</div>
            </div>
        </div>

        <form asp-action="Create" method="post" id="wizardForm" data-ajax-tarea="true" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger mb-2"></div>

            <input asp-for="Id" type="hidden" />
            <input asp-for="RowVersion" type="hidden" />
            <input asp-for="SolicitudId" type="hidden" />

            <!-- PASO 1 -->
            <div class="form-step active" data-step="1">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="CategoriaId" class="form-label"></label>
                        <select asp-for="CategoriaId" asp-items="Model.Categorias"
                                class="form-select" id="CategoriaServicioId">
                            <option value="">-- Seleccione categoría --</option>
                        </select>
                        <span asp-validation-for="CategoriaId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6" id="grupoTipoServicio">
                        <label asp-for="TipoServicioId" class="form-label"></label>
                        <select asp-for="TipoServicioId" class="form-select" id="TipoServicioId">
                            <option value="">-- Seleccione tipo de servicio --</option>

                            @foreach (var tipo in Model.TiposServicio)
                            {
                                <option value="@tipo.Id"
                                        data-categoria="@tipo.CategoriaId">
                                    @tipo.Nombre
                                </option>
                            }
                        </select>
                        <span asp-validation-for="TipoServicioId" class="text-danger"></span>
                        <p>primero elegir categoria</p>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Titulo" class="form-label"></label>
                    <input asp-for="Titulo" class="form-control" />
                    <span asp-validation-for="Titulo" class="text-danger"></span>
                </div>
            </div>

            <!-- PASO 2 -->
            <div class="form-step" data-step="2">
                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label"></label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>
                <div class="row g-3">               
                    <div class="col-md-6">
                        <label asp-for="DivisionId" class="form-label"></label>
                        <select asp-for="DivisionId"
                                asp-items="Model.Divisiones"
                                class="form-select" id="DivisionId">
                            <option value="">-- Seleccione división --</option>
                        </select>
                        <span asp-validation-for="DivisionId" class="text-danger"></span>
                    </div>
                    <div class="col-md-6" id="grupoUnidad">
                        <label asp-for="UnidadId" class="form-label"></label>
                        <select asp-for="UnidadId" class="form-select" id="UnidadId">
                            <option value="">-- Seleccione unidad --</option>

                            @foreach (var u in Model.Unidades)
                            {
                                var divisionId = u.DivisionId.HasValue ? u.DivisionId.Value.ToString() : "";
                                <option value="@u.Id" data-division="@divisionId">@u.Nombre</option>

                            }
                        </select>
                        <span asp-validation-for="UnidadId" class="text-danger"></span>
                        <p>si no elige division solo apareceran unidades sin division</p>
                    </div>
                </div>            
            </div>
            <!-- PASO 3 -->
            <div class="form-step" data-step="3">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Prioridad" class="form-label"></label>
                        <select asp-for="Prioridad" class="form-select" asp-items="Html.GetEnumSelectList<Prioridad>()">
                            <option value="">-- Seleccione Prioridad --</option>
                        </select>
                        <span asp-validation-for="Prioridad" class="text-danger"></span>
                    </div>
                    @if (Model.SolicitudId.HasValue)
                    {
                        <input asp-for="UsuarioId" type="hidden" />

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Usuario solicitante</label>
                            <input class="form-control" value="@Model.UsuarioNombre" disabled />
                        </div>
                    }
                    else
                    {
                        <div class="col-md-6 mb-3"
                             data-usuarios-url="@Url.Action("Buscar", "Tarea")">
                            <label asp-for="UsuarioId" class="form-label"></label>

                            <div class="position-relative">
                                <!-- Buscador -->
                                <input type="text"
                                       id="usuarioBuscador"
                                       class="form-control mb-1"
                                       placeholder="Escriba el nombre del usuario"
                                       autocomplete="off" />

                                <!-- Lista de resultados -->
                                <div id="usuarioResultados"
                                     class="list-group position-absolute w-100 d-none"
                                     style="z-index: 1055; max-height: 220px; overflow-y: auto;">
                                </div>
                            </div>

                            <!-- Hidden con el Id real -->
                            <input asp-for="UsuarioId" type="hidden" id="UsuarioId" />
                            <span asp-validation-for="UsuarioId" class="text-danger"></span>
                        </div>
                    }
                </div>

            </div>
            <!-- PASO 4 -->
            <div class="form-step" data-step="4">
                <div class="row g-3">
                <!-- Fecha vencimiento -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="FechaLimite" class="form-label">Fecha vencimiento (opcional)</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">
                                <i class="bi bi-calendar-event"></i>
                            </span>
                            <input asp-for="FechaLimite" type="date" class="form-control" />
                        </div>
                        <span asp-validation-for="FechaLimite" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="TecnicoId" class="form-label">Técnico (opcional)</label>
                        <select asp-for="TecnicoId" asp-items="Model.Tecnicos" class="form-select">
                            <option value="">-- Sin asignar --</option>
                        </select>
                        <span asp-validation-for="TecnicoId" class="text-danger"></span>
                    </div>
                </div>
                <h5 class="mb-3">
                    <i class="bi bi-clipboard2-check me-2"></i> Revisión final
                </h5>

                <!-- Card de resumen -->
                <div class="resumen-card rounded-3 p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <div class="text-uppercase text-muted small fw-semibold mb-1">Título</div>
                            <h6 id="resumenTitulo" class="mb-0"></h6>
                        </div>

                        <div class="text-end">
                            <div class="text-uppercase text-muted small fw-semibold mb-1">Prioridad</div>
                            <span class="badge-soft rounded-pill px-3 py-1" id="resumenPrioridad"></span>
                        </div>
                    </div>

                    <hr class="my-3">

                    <div class="mb-2">
                        <div class="text-uppercase text-muted small fw-semibold mb-1">Descripción</div>
                        <p id="resumenDescripcion" class="mb-0 small"></p>
                    </div>

                    <div class="mt-3 d-flex align-items-center small text-muted gap-2">
                        <i class="bi bi-calendar-check me-1"></i>
                        <span id="resumenFechaLimiteTexto">Sin fecha de vencimiento</span>
                    </div>
                </div>
            </div>


            <!-- BOTONES -->
            <div class="d-flex justify-content-between mt-4">
                <button type="button" class="btn btn-outline-light d-none" id="btnPrev">
                    <i class="bi bi-arrow-left-circle me-1"></i> Anterior
                </button>

                <div class="ms-auto d-flex gap-2">
                    <button type="button" class="btn btn-gradient-primary" id="btnNext">
                        Siguiente <i class="bi bi-arrow-right-circle ms-1"></i>
                    </button>

                    <button type="submit" class="btn btn-success d-none" id="btnSubmit">
                        <i class="bi bi-check2-circle me-1"></i> Guardar tarea
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<script type="application/json" id="tipoServicio-map">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MapTipoDesc))
</script>